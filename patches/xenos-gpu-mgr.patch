diff --git a/include/rex/graphics/vulkan/mgr_cmd_stats.h b/include/rex/graphics/vulkan/mgr_cmd_stats.h
new file mode 100644
index 0000000..13e8e0f
--- /dev/null
+++ b/include/rex/graphics/vulkan/mgr_cmd_stats.h
@@ -0,0 +1,47 @@
+// MGR port diagnostic: counts recorded Vulkan commands per call site.
+// Enabled with MGR_GPU_STATS=1; prints a per-frame breakdown every few seconds.
+#pragma once
+
+#include <string>
+
+namespace rex::graphics::vulkan::mgr_stats {
+
+enum class Kind {
+  kBeginRenderPass,
+  kBeginRendering,
+  kDispatch,
+  kCopyBuffer,
+  kCopyBufferToImage,
+  kBarrier,
+  kDraw,
+  kClearAttachments,
+  kSubmission,
+  kCount
+};
+
+bool Enabled();
+void AddBusyNanoseconds(long long ns);
+void AddWaitNanoseconds(long long ns);  // blocking GPU fence waits (subset of busy)
+long long NowNanoseconds();
+
+// Accumulates GPU command processor busy time (reported per frame).
+struct BusyScope {
+  long long start = Enabled() ? NowNanoseconds() : 0;
+  ~BusyScope() {
+    if (start) AddBusyNanoseconds(NowNanoseconds() - start);
+  }
+};
+void Record(Kind kind, const void* call_site);
+// Symbol name, or <dylib>+0x<offset> for hidden symbols (resolve with atos).
+std::string Symbolize(const void* addr);
+void OnFrame();
+
+}  // namespace rex::graphics::vulkan::mgr_stats
+
+#define MGR_STAT(kind)                                                         \
+  do {                                                                         \
+    if (::rex::graphics::vulkan::mgr_stats::Enabled())                         \
+      ::rex::graphics::vulkan::mgr_stats::Record(                              \
+          ::rex::graphics::vulkan::mgr_stats::Kind::kind,                      \
+          __builtin_return_address(0));                                        \
+  } while (0)
diff --git a/include/rex/graphics/vulkan/mgr_gpu_timing.h b/include/rex/graphics/vulkan/mgr_gpu_timing.h
new file mode 100644
index 0000000..e2514f9
--- /dev/null
+++ b/include/rex/graphics/vulkan/mgr_gpu_timing.h
@@ -0,0 +1,177 @@
+// MGR port diagnostic: GPU execution time from Vulkan timestamp queries.
+//   MGR_GPU_TIMING=1  per guest frame: start/end of every submission.
+//   MGR_GPU_TIMING=2  also every render pass, dispatch and buffer copy, keyed
+//                     by recording call site, reported as a per-frame breakdown.
+//                     Zones are also attributed to the guest shader of their
+//                     draws (resolves and texture loads to the shader of the
+//                     draw that issued them), with command-processor CPU time
+//                     per shader, reported as a per-effect breakdown.
+//   MGR_GPU_TIMING_CSV=<path>  one row per frame (busy, span, gap).
+//   MGR_SHADER_NAMES=<path>  "hash<TAB>name" lines labelling effect tags
+//                     (tools/analysis/shader_names.py); unnamed tags print as hashes.
+// Results are read only for submissions whose fence has already signaled, so
+// the timer never waits on the GPU. On Apple GPUs MoltenVK samples at encoder
+// boundaries; level 2 splits encoders and so perturbs what it measures.
+#pragma once
+
+#include <array>
+#include <cstdint>
+#include <cstdio>
+#include <deque>
+#include <map>
+#include <tuple>
+#include <vector>
+
+#include <rex/ui/vulkan/api.h>
+
+namespace rex::ui::vulkan {
+class VulkanDevice;
+}  // namespace rex::ui::vulkan
+
+namespace rex::graphics::vulkan::mgr_timing {
+
+// 0 off, 1 submissions, 2 submissions and zones.
+int Level();
+
+enum class ZoneKind : uint8_t { kRenderPass, kDispatch, kCopyBuffer, kCopyBufferToImage };
+
+// Effect tag of a draw: its guest pixel shader ucode hash, or for draws without
+// a pixel shader (depth-only) the vertex shader hash with this bit set.
+constexpr uint64_t kVertexShaderTagBit = uint64_t(1) << 63;
+
+class GpuTimer {
+ public:
+  bool Initialize(const ui::vulkan::VulkanDevice* device);
+  void Shutdown();
+  bool enabled() const { return query_pool_ != VK_NULL_HANDLE; }
+  bool zones_enabled() const { return zone_pool_ != VK_NULL_HANDLE; }
+  // A/B experiments: variant applied to the command buffer being recorded.
+  // Frames take the variant of their last submission; reports and the CSV
+  // are split by variant.
+  void SetVariant(uint32_t variant) { recording_variant_ = variant; }
+
+  // Called with the primary command buffer of `submission` right after
+  // vkBeginCommandBuffer and right before vkEndCommandBuffer.
+  void BeginCommandBuffer(VkCommandBuffer command_buffer, uint64_t submission);
+  void EndCommandBuffer(VkCommandBuffer command_buffer);
+  // Zones never nest and are recorded outside render passes. `a`/`b` are the
+  // render area or dispatch group counts; `draws` counts draws in a pass.
+  void ZoneBegin(VkCommandBuffer command_buffer, ZoneKind kind, const void* site, uint32_t a,
+                 uint32_t b);
+  void ZoneEnd(VkCommandBuffer command_buffer, uint32_t draws);
+  // Effect attribution (level 2), called while a command buffer is executed:
+  // the tag applies to following zones and draws until the next tag.
+  void SetEffectTag(uint64_t tag) { effect_tag_ = tag; }
+  void NoteDraw();
+  // Command-processor CPU time spent recording a draw (`copy` false) or a
+  // resolve (`copy` true) for `tag`, on the thread that executes the buffer.
+  void AddCpu(uint64_t tag, uint64_t ns, bool copy);
+  // EDRAM multisampling of a draw: bit (log2 samples) of the tag's sample mask.
+  void NoteMsaa(uint64_t tag, uint32_t log2_samples) {
+    window_cpu_[tag].msaa_mask |= uint8_t(1u << log2_samples);
+  }
+  // `last_submission` is the final submission belonging to the closed frame.
+  void FrameClosed(uint64_t last_submission);
+  // Reads every pending submission <= completed (fence already signaled).
+  void SubmissionsCompleted(uint64_t completed);
+
+ private:
+  static constexpr uint32_t kSlotCount = 256;
+  // Metal counter sample buffers hold at most 32 KiB (4096 timestamps); a
+  // larger pool makes MoltenVK fall back to CPU-emulated timestamps.
+  static constexpr uint32_t kZoneQueryCount = 4096;
+  struct Slot {
+    uint64_t submission = 0;
+    bool pending = false;
+    uint32_t variant = 0;
+  };
+  struct Zone {
+    ZoneKind kind;
+    const void* site;
+    uint32_t a, b, draws, query;
+    uint64_t tag;  // dominant effect tag (most draws), else the tag at begin
+  };
+  // Draws per tag within the open zone; passes rarely mix more shaders.
+  static constexpr size_t kZoneTagSlots = 8;
+  struct ZoneTagDraws {
+    uint64_t tag;
+    uint32_t draws;
+  };
+  // effect tag, zone kind, site
+  using EffectKey = std::tuple<uint64_t, int, const void*>;
+  struct CpuTotals {
+    double draw_ns = 0, copy_ns = 0;
+    uint64_t draws = 0, copies = 0;
+    uint8_t msaa_mask = 0;  // bit n: draws with 2^n samples
+  };
+  struct ZoneSubmission {
+    uint64_t submission;
+    std::vector<Zone> zones;
+  };
+  // kind, site, render-pass index in frame (passes only), a, b
+  using ZoneKey = std::tuple<int, const void*, uint32_t, uint32_t, uint32_t>;
+  struct ZoneTotals {
+    double ns = 0;
+    uint64_t count = 0, draws = 0;
+  };
+  struct FrameSample {
+    double busy_ms, span_ms, gap_ms;
+    uint32_t variant;
+  };
+
+  bool ReadZones(const ZoneSubmission& submission);
+  void AddSubmission(uint64_t submission, uint64_t begin_ns, uint64_t end_ns);
+  void FinishFrame();
+  void Report();
+  void ReportEffects(double frames);
+  uint64_t TicksToNs(uint64_t ticks) const;
+
+  VkDevice device_ = VK_NULL_HANDLE;
+  PFN_vkDestroyQueryPool destroy_query_pool_ = nullptr;
+  PFN_vkCmdResetQueryPool cmd_reset_query_pool_ = nullptr;
+  PFN_vkCmdWriteTimestamp cmd_write_timestamp_ = nullptr;
+  PFN_vkGetQueryPoolResults get_query_pool_results_ = nullptr;
+  VkQueryPool query_pool_ = VK_NULL_HANDLE;
+  double ns_per_tick_ = 1.0;
+  uint64_t tick_mask_ = ~uint64_t(0);
+
+  std::array<Slot, kSlotCount> slots_{};
+  uint32_t recording_slot_ = UINT32_MAX;
+  uint64_t recording_submission_ = 0;
+  uint32_t recording_variant_ = 0;
+  uint32_t frame_variant_ = 0;
+  uint64_t next_collect_ = 1;
+  std::deque<uint64_t> frame_ends_;
+
+  // Zones (level 2).
+  VkQueryPool zone_pool_ = VK_NULL_HANDLE;
+  uint32_t zone_query_next_ = 0, zone_queries_in_use_ = 0;
+  std::vector<Zone> recording_zones_;
+  bool zone_open_ = false;
+  std::deque<ZoneSubmission> zone_submissions_;
+  uint32_t frame_render_pass_index_ = 0;
+  double frame_zone_ns_ = 0;
+  std::map<ZoneKey, ZoneTotals> window_zones_;
+  double window_zone_ns_ = 0;
+  uint64_t zones_skipped_ = 0;
+
+  // Effect attribution (level 2).
+  uint64_t effect_tag_ = 0;
+  std::array<ZoneTagDraws, kZoneTagSlots> zone_tags_{};
+  size_t zone_tag_count_ = 0;
+  std::map<EffectKey, ZoneTotals> window_effects_;
+  std::map<uint64_t, CpuTotals> window_cpu_;
+
+  // Frame being accumulated from completed submissions.
+  double frame_busy_ns_ = 0;
+  uint64_t frame_first_begin_ns_ = 0, frame_last_end_ns_ = 0;
+  uint64_t previous_frame_end_ns_ = 0;
+  bool frame_has_work_ = false;
+
+  std::vector<FrameSample> window_;
+  uint64_t window_first_ns_ = 0, window_last_ns_ = 0;
+  uint64_t frames_total_ = 0, untimed_submissions_ = 0;
+  FILE* csv_ = nullptr;
+};
+
+}  // namespace rex::graphics::vulkan::mgr_timing
diff --git a/include/rex/graphics/vulkan/mgr_native_ps.h b/include/rex/graphics/vulkan/mgr_native_ps.h
new file mode 100644
index 0000000..536e5b5
--- /dev/null
+++ b/include/rex/graphics/vulkan/mgr_native_ps.h
@@ -0,0 +1,105 @@
+// MGR port: native pixel shaders (offline XenosRecomp) for the Xenos Vulkan backend.
+//
+// Draws keep Xenia's translated vertex shader, render target cache, texture
+// cache and primitive processing; the pixel stage uses an offline-recompiled
+// shader from the MGR native bundle (tools: XenosRecomp, patches/xenosrecomp-mgr.patch).
+// Descriptor set 3 (Xenia's pixel texture set) is replaced by the native set:
+//   binding 0: storage buffer, 256 float4 pixel shader constants (host endian)
+//   binding 1: storage buffer, shared constants (booleans at 512, alpha ref at 556)
+//   binding 2/3/4: sampled image arrays [32] (2D / 3D / cube), index = fetch constant
+//   binding 5: sampler array [32]
+#pragma once
+
+#include <cstdint>
+#include <memory>
+#include <string>
+#include <unordered_map>
+#include <vector>
+
+#include <rex/ui/vulkan/api.h>
+
+namespace rex::ui::vulkan {
+class VulkanDevice;
+class VulkanUploadBufferPool;
+}  // namespace rex::ui::vulkan
+
+namespace rex::graphics::vulkan::mgr_native {
+
+constexpr uint32_t kSlotCount = 32;
+constexpr uint32_t kPixelConstantsBytes = 256 * 16;
+constexpr uint32_t kSharedConstantsBytes = 592;
+constexpr uint32_t kSharedBooleansOffset = 512;
+constexpr uint32_t kSharedAlphaThresholdOffset = 556;
+constexpr uint32_t kSpecConstantAlphaTest = 1u << 1;  // SPEC_CONSTANT_ALPHA_TEST
+
+enum Binding : uint32_t {
+  kBindingPixelConstants,
+  kBindingSharedConstants,
+  kBindingTextures2D,
+  kBindingTextures3D,
+  kBindingTexturesCube,
+  kBindingSamplers,
+  kBindingCount
+};
+
+struct PixelShader {
+  uint64_t ucode_hash = 0;
+  uint32_t spec_constants_mask = 0;
