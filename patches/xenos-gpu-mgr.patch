+                                                   pair_address.x).xz;
+    pixels_0123.zw = byte_buffer_align16_load16_xe(xe_resolve_edram,
+                                                   pair_address.y).xz;
+    pixels_4567.xy = byte_buffer_align16_load16_xe(xe_resolve_edram,
+                                                   pair_address.z).xz;
+    pixels_4567.zw = byte_buffer_align16_load16_xe(xe_resolve_edram,
+                                                   pair_address.w).xz;
