diff --git a/include/rex/graphics/vulkan/resolve_arena.h b/include/rex/graphics/vulkan/resolve_arena.h
new file mode 100644
index 0000000..216e928
--- /dev/null
+++ b/include/rex/graphics/vulkan/resolve_arena.h
@@ -0,0 +1,114 @@
+#pragma once
+
+#include <algorithm>
+#include <cstdint>
+#include <vector>
+
+namespace rex::graphics::vulkan {
+
+// GPU-independent address planner. Allocation failure never evicts live data.
+// The caller records copies before using the newly published mapping. Retired
+// blocks remain unavailable until the submission containing those copies ends.
+class ResolveArena {
+ public:
+  struct Copy { uint64_t source, destination, length; };
+  struct Block {
+    uint64_t guest_begin, guest_end, offset, size;
+    uint64_t retire_after = 0;
+    bool retired = false;
+  };
+
+  void Reset(uint64_t capacity, uint32_t area, uint64_t alignment) {
+    capacity_ = capacity;
+    area_ = area;
+    alignment_ = std::max<uint64_t>(alignment, 1);
+    blocks_.clear();
+  }
+
+  bool Lookup(uint64_t begin, uint64_t length, uint64_t& offset) const {
+    if (!length) { offset = 0; return true; }
+    if (begin > kGuestSize || length > kGuestSize - begin) return false;
+    for (const Block& block : blocks_) {
+      if (!block.retired && begin >= block.guest_begin &&
+          begin + length <= block.guest_end) {
+        offset = block.offset + (begin - block.guest_begin) * area_;
+        return true;
+      }
+    }
+    return false;
+  }
+
+  bool Commit(uint64_t begin, uint64_t length, uint64_t submission,
+              uint64_t completed, std::vector<Copy>& copies,
+              bool overwrite_existing = false) {
+    copies.clear();
+    if (!length) return true;
+    if (!area_ || begin > kGuestSize || length > kGuestSize - begin) return false;
+    uint64_t existing;
+    if (Lookup(begin, length, existing)) return true;
+    uint64_t end = (begin + length + 4095) & ~uint64_t(4095);
+    begin &= ~uint64_t(4095);
+    // Retain the range actually being resolved before expanding to include
+    // whole overlapped blocks. A block fully inside the requested range is
+    // overwritten by the new resolve and does not need to be copied.
+    const uint64_t requested_begin = begin;
+    const uint64_t requested_end = end;
+    // Existing mappings are disjoint. Expand to preserve the full contents of
+    // every overlapped allocation, including bytes outside the new resolve.
+    bool expanded;
+    do {
+      expanded = false;
+      for (const Block& block : blocks_) {
+        if (block.retired || block.guest_end <= begin || block.guest_begin >= end) continue;
+        const uint64_t next_begin = std::min(begin, block.guest_begin);
+        const uint64_t next_end = std::max(end, block.guest_end);
+        expanded |= next_begin != begin || next_end != end;
+        begin = next_begin;
+        end = next_end;
+      }
+    } while (expanded);
+    const uint64_t size = (end - begin) * area_;
+    if (size > capacity_) return false;
+    blocks_.erase(std::remove_if(blocks_.begin(), blocks_.end(),
+        [completed](const Block& block) {
+          return block.retired && block.retire_after <= completed;
+        }), blocks_.end());
+    std::sort(blocks_.begin(), blocks_.end(), [](const Block& a, const Block& b) {
+      return a.offset < b.offset;
+    });
+    uint64_t offset = 0;
+    for (const Block& block : blocks_) {
+      if (offset <= block.offset && size <= block.offset - offset) break;
+      offset = ((block.offset + block.size + alignment_ - 1) / alignment_) * alignment_;
+    }
+    if (offset > capacity_ || size > capacity_ - offset) return false;
+    for (Block& block : blocks_) {
+      if (block.retired || block.guest_end <= begin || block.guest_begin >= end) continue;
+      // A resolve that is known to overwrite this whole block does not need to
+      // preserve it. Texture-load commits only read the arena, so they still
+      // copy any overlapping contents.
+      if (!overwrite_existing || block.guest_begin < requested_begin ||
+          block.guest_end > requested_end) {
+        copies.push_back({block.offset, offset + (block.guest_begin - begin) * area_, block.size});
+      }
+      block.retired = true;
+      block.retire_after = submission;
+    }
+    blocks_.push_back({begin, end, offset, size});
+    return true;
+  }
+
+  uint64_t live_bytes() const {
+    uint64_t total = 0;
+    for (const Block& block : blocks_) if (!block.retired) total += block.size;
+    return total;
+  }
+  const std::vector<Block>& blocks() const { return blocks_; }
+  static constexpr uint64_t kGuestSize = uint64_t(512) << 20;
+
+ private:
+  uint64_t capacity_ = 0, alignment_ = 1;
+  uint32_t area_ = 0;
+  std::vector<Block> blocks_;
+};
+}  // namespace rex::graphics::vulkan
