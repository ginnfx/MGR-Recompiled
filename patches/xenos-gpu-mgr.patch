+void VulkanPipelineCache::InitializeNativePipelineStorage(const std::filesystem::path& cache_root,
+                                                          uint32_t title_id,
+                                                          const NativePipelineResolver& resolver) {
+  if (native_storage_file_) {
+    fclose(native_storage_file_);
+    native_storage_file_ = nullptr;
+  }
+  const auto path = cache_root / "shaders" / "shareable" /
+                    fmt::format("{:08X}.mgr_native.vk.bin", title_id);
+  native_storage_file_ = rex::filesystem::OpenFile(path, "a+b");
+  if (!native_storage_file_) {
+    REXGPU_WARN("MGR native PS: cannot open pipeline storage {}", rex::path_to_utf8(path));
+    return;
+  }
+  struct {
+    uint32_t magic;
+    uint32_t version;
+  } header = {}, expected = {kNativeStorageMagic, PipelineDescription::kVersion ^
+                                                      uint32_t(sizeof(NativePipelineStoredDescription))};
+  rex::filesystem::Seek(native_storage_file_, 0, SEEK_SET);
+  std::vector<NativePipelineStoredDescription> records;
+  if (fread(&header, sizeof(header), 1, native_storage_file_) == 1 &&
+      header.magic == expected.magic && header.version == expected.version) {
+    NativePipelineStoredDescription record;
+    while (fread(&record, sizeof(record), 1, native_storage_file_) == 1 &&
+           record.record_hash == record.ComputeHash()) {
+      records.push_back(record);
+    }
+  }
+  // Keep the valid prefix; a stale or corrupt file restarts empty.
+  if (records.empty() && std::memcmp(&header, &expected, sizeof(header)) != 0) {
+    rex::filesystem::TruncateStdioFile(native_storage_file_, 0);
+    fwrite(&expected, sizeof(expected), 1, native_storage_file_);
+  } else {
+    rex::filesystem::TruncateStdioFile(
+        native_storage_file_, sizeof(header) + sizeof(NativePipelineStoredDescription) * records.size());
+  }
+  fflush(native_storage_file_);
+  rex::filesystem::Seek(native_storage_file_, 0, SEEK_END);
+
+  const bool async = REXCVAR_GET(async_shader_compilation) && !creation_threads_.empty();
+  size_t queued = 0;
+  for (const NativePipelineStoredDescription& record : records) {
+    const NativePipelineInputs inputs{record.pixel_ucode_hash, record.interpolator_mask,
+                                      record.vertex_texture_count, record.vertex_sampler_count};
+    VkShaderModule module = VK_NULL_HANDLE;
+    const PipelineLayoutProvider* layout = nullptr;
+    if (!resolver(inputs, module, layout) || module == VK_NULL_HANDLE || !layout) {
+      continue;
+    }
+    NativePipelineKey key{record.description, module, record.spec_constants};
+    if (native_pipelines_.count(key)) {
+      continue;
+    }
+    EnsureStoredTranslation(record.description.vertex_shader_hash,
+                            record.description.vertex_shader_modification);
+    if (record.description.pixel_shader_hash) {
+      EnsureStoredTranslation(record.description.pixel_shader_hash,
+                              record.description.pixel_shader_modification);
+    }
+    auto storage = std::make_unique<std::pair<const PipelineDescription, Pipeline>>(
+        record.description, Pipeline());
+    PipelineCreationArguments creation_arguments;
+    if (!TryGetPipelineCreationArgumentsForDescription(record.description, storage.get(),
+                                                       creation_arguments)) {
+      continue;
+    }
+    creation_arguments.pipeline_layout = layout;
+    creation_arguments.native_pixel_shader = module;
+    creation_arguments.native_spec_constants = record.spec_constants;
+    native_pipelines_.emplace(key, std::move(storage));
+    if (async) {
+      std::lock_guard<std::mutex> lock(creation_request_lock_);
+      native_creation_queue_.push_back(creation_arguments);
+    } else {
+      CreateNativePipeline(creation_arguments);
+    }
+    ++queued;
+  }
+  if (async && queued) {
+    creation_request_cond_.notify_all();
+  }
