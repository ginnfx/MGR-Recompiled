index 0000000..528aa06
--- /dev/null
+++ b/src/graphics/shaders/xesl/gpu/shaders/resolve_fast_32bpp_1x2xmsaa_rational.xesli
@@ -0,0 +1,95 @@
+/**
+ ******************************************************************************
+ * Xenia : Xbox 360 Emulator Research Project                                 *
+ ******************************************************************************
+ * Copyright 2022 Ben Vanik. All rights reserved.                             *
+ * Released under the BSD license - see LICENSE in the root for more details. *
+ ******************************************************************************
+ */
+
+// MGR port: resolve_fast_32bpp_1x2xmsaa for a rational (3/2) resolution scale, see
+// resolution_scale.xesli. Differences from resolve_fast_32bpp_1x2xmsaa.xesli:
+// - Rows are 12 host pixels per 8 guest pixels, so a group is 4 threads high
+//   and the dispatch covers exactly the rectangle; width_scaled bounds X.
+// - EDRAM is read per pixel pair: a longer run may cross a 3/2 tile boundary
+//   (or, for depth, the swapped tile halves).
+
+#include "endian.xesli"
+#define XE_RESOLVE_COPY_EDRAM_BYTE_BUFFER_ALIGNMENT 8
+#include "resolve.xesli"
+
+byte_buffer_align16_wo_declare_xe(xe_resolve_dest, set=1, binding=0, u0, space0)
+
+uint XeResolveFastPairSourceAddress(XeResolveInfo resolve_info,
+                                    uint2_xe pixel_index) {
+  return XeEdramOffsetBytes(
+      uint2_xe(pixel_index.x,
+               max(pixel_index.y,
+                   resolve_info.half_pixel_offset_fill_source.y)) +
+          resolve_info.edram_offset_scaled,
+      resolve_info.edram_base_tiles, true, resolve_info.edram_pitch_tiles,
+      resolve_info.edram_msaa_samples, resolve_info.edram_is_depth, 0u,
+      XeResolveFirstSampleIndex(resolve_info.sample_select),
+      resolve_info.resolution_scale);
+}
+#define LOCAL_SIZE_X_XE 8
+#define LOCAL_SIZE_Y_XE 4
+#define LOCAL_SIZE_Z_XE 1
+entry_bindings_begin_compute_xe
+  XE_RESOLVE_PUSH_CONST_BINDING
+  entry_binding_next_xe
+  byte_buffer_wo_binding_xe(xe_resolve_dest, buffer(1))
+  entry_binding_next_xe
+  XE_RESOLVE_COPY_EDRAM_BINDING
+entry_bindings_end_inputs_begin_compute_xe
+  entry_in_global_thread_id_xe
+entry_inputs_end_code_begin_compute_xe
+{
+  // 1 thread = 8 host pixels.
+  XeResolveInfo resolve_info = XeResolveGetInfo(pass_push_consts_xe);
+  uint2_xe pixel_index = in_global_thread_id_xe.xy << uint2_xe(3u, 0u);
+  dont_flatten_xe
+  if (pixel_index.x >= resolve_info.width_scaled) {
+    return;
+  }
+  uint4_xe pair_address = uint4_xe(
+      XeResolveFastPairSourceAddress(resolve_info, pixel_index),
+      XeResolveFastPairSourceAddress(resolve_info,
+                                     pixel_index + uint2_xe(2u, 0u)),
+      XeResolveFastPairSourceAddress(resolve_info,
+                                     pixel_index + uint2_xe(4u, 0u)),
+      XeResolveFastPairSourceAddress(resolve_info,
+                                     pixel_index + uint2_xe(6u, 0u)));
+  uint4_xe pixels_0123, pixels_4567;
+  pixels_0123.xy = byte_buffer_align8_load8_xe(xe_resolve_edram, pair_address.x);
+  pixels_0123.zw = byte_buffer_align8_load8_xe(xe_resolve_edram, pair_address.y);
+  pixels_4567.xy = byte_buffer_align8_load8_xe(xe_resolve_edram, pair_address.z);
+  pixels_4567.zw = byte_buffer_align8_load8_xe(xe_resolve_edram, pair_address.w);
+  dont_flatten_xe
+  if (pixel_index.x == 0u &&
+      resolve_info.half_pixel_offset_fill_source.x != 0u) {
+    if (resolve_info.half_pixel_offset_fill_source.x >= 2u) {
+      if (resolve_info.half_pixel_offset_fill_source.x >= 3u) {
+        pixels_0123.z = pixels_0123.w;
+      }
+      pixels_0123.y = pixels_0123.z;
+    }
+    pixels_0123.x = pixels_0123.y;
+  }
+  XeResolveSwap8PixelsRedBlue32bpp(resolve_info, pixels_0123, pixels_4567);
+  // The destination offset is a multiple of 12 host pixels, so the two
+  // halves may be in different 8-pixel host groups; each 4 is contiguous. The
+  // last thread of a row may cover 4 pixels only (rows are 12k wide).
+  byte_buffer_align16_store16_xe(
+      xe_resolve_dest, XeResolveDestPixelAddress(resolve_info, pixel_index, 2u),
+      XeEndianSwap32(pixels_0123, resolve_info.dest_endian_128));
+  dont_flatten_xe
+  if (pixel_index.x + 4u < resolve_info.width_scaled) {
+    byte_buffer_align16_store16_xe(
+        xe_resolve_dest,
+        XeResolveDestPixelAddress(resolve_info, pixel_index + uint2_xe(4u, 0u),
+                                  2u),
+        XeEndianSwap32(pixels_4567, resolve_info.dest_endian_128));
+  }
+}
+entry_code_end_compute_xe
