diff --git a/src/graphics/shaders/xesl/build_rational_spirv.sh b/src/graphics/shaders/xesl/build_rational_spirv.sh
new file mode 100755
index 0000000..5a878e7
--- /dev/null
+++ b/src/graphics/shaders/xesl/build_rational_spirv.sh
@@ -0,0 +1,38 @@
+#!/bin/bash
+# MGR port: builds the 3/2 resolution-scale compute shaders (*_rational.cs.xesl)
+# into ../vulkan_spirv/<name>_cs.h, with the upstream Xenia `xb buildshaders`
+# GLSL recipe (glslang -V, then spirv-opt -O --canonicalize-ids).
+# Requires glslang and spirv-tools (Homebrew: glslang, spirv-tools).
+# Usage: build_rational_spirv.sh [name ...]   (default: every *_rational.cs.xesl)
+set -euo pipefail
+HERE="$(cd "$(dirname "$0")" && pwd)"
+SRC="$HERE/gpu/shaders"
+OUT="$HERE/../vulkan_spirv"
+TMP="$(mktemp -d)"
+trap 'rm -rf "$TMP"' EXIT
+
+if [ $# -eq 0 ]; then
+  set -- $(cd "$SRC" && ls *_rational.cs.xesl | sed 's/\.cs\.xesl$//')
+fi
+for name in "$@"; do
+  printf '%s\n' '#version 460' \
+    '#extension GL_EXT_control_flow_attributes : require' \
+    '#extension GL_EXT_samplerless_texture_functions : require' \
+    '#extension GL_GOOGLE_include_directive : require' \
+    "#include \"$name.cs.xesl\"" |
+    glslang --stdin -DSHADING_LANGUAGE_GLSL_XE=1 -S comp -V -I"$SRC" \
+      -o "$TMP/$name.glslang.spv" >"$TMP/$name.log" 2>&1 || { cat "$TMP/$name.log"; exit 1; }
+  spirv-opt -O --canonicalize-ids "$TMP/$name.glslang.spv" -o "$TMP/$name.spv"
+  spirv-val "$TMP/$name.spv"
+  {
+    echo "// Generated by src/graphics/shaders/xesl/build_rational_spirv.sh from"
+    echo "// xesl/gpu/shaders/$name.cs.xesl. Do not edit."
+    echo ""
+    echo "const uint32_t ${name}_cs[] = {"
+    od -An -v -tx4 "$TMP/$name.spv" | tr -s ' ' '\n' | sed '/^$/d' |
+      awk '{ printf "%s0x%s,", (NR % 8 == 1 ? "    " : " "), toupper($1);
+             if (NR % 8 == 0) printf "\n" } END { if (NR % 8) printf "\n" }'
+    echo "};"
+  } >"$OUT/${name}_cs.h"
+  echo "$name: $(($(wc -c <"$TMP/$name.spv") / 4)) words"
+done
