+// MGR port experiment: guest render passes cover the whole host render target
+// (1280x2048 at 1x) while drawing far fewer rows. MoltenVK sizes the Metal
+// render target (tile load/store) from the render area, so shrink it to what
+// the pass draws. MGR_TIGHT_RENDER_AREA: unset/0 off, 1 on, ab alternate every
+// second (A/B within one run; the GPU timer tags frames with the variant).
+int TightRenderAreaMode() {
+  static const int mode = [] {
+    const char* v = std::getenv("MGR_TIGHT_RENDER_AREA");
+    if (!v) return 0;
+    if (std::string_view(v) == "ab") return 2;
+    return v[0] == '1' ? 1 : 0;
+  }();
+  return mode;
+}
+
+uint32_t TightRenderAreaVariant() {
+  const int mode = TightRenderAreaMode();
+  if (mode < 2) return uint32_t(mode);
+  const auto seconds = std::chrono::duration_cast<std::chrono::seconds>(
+      std::chrono::steady_clock::now().time_since_epoch()).count();
+  return uint32_t(seconds & 1);
