+++ b/src/graphics/shaders/xesl/gpu/shaders/texture_load_r5g6b5_rgba8_scaled_rational.cs.xesl
@@ -0,0 +1,26 @@
+/**
+ ******************************************************************************
+ * Xenia : Xbox 360 Emulator Research Project                                 *
+ ******************************************************************************
+ * Copyright 2022 Ben Vanik. All rights reserved.                             *
+ * Released under the BSD license - see LICENSE in the root for more details. *
+ ******************************************************************************
+ */
+
+// MGR port: 3/2 resolution scale version of ReXGlue's hand-written
+// texture_load_r5g6b5_rgba8_scaled SPIR-V (same transform).
+#define XE_TEXTURE_LOAD_RESOLUTION_SCALED
+#define XE_RESOLUTION_SCALE_RATIONAL
+#include "../../ui/shaders/xesl.xesli"
+uint4_xe XeR5G6B5ToRGBA8(uint4_xe blocks) {
+  uint4_xe r = blocks & 31u;
+  uint4_xe g = (blocks >> 5u) & 63u;
+  uint4_xe b = blocks >> 11u;
+  r = (r << 3u) | (r >> 2u);
+  g = (g << 2u) | (g >> 4u);
+  b = (b << 3u) | (b >> 2u);
+  // As in the original SPIR-V: alpha repeats blue (the 5_6_5 swizzle drops it).
+  return r | (g << 8u) | (b << 16u) | (b << 24u);
+}
+#define XE_TEXTURE_LOAD_16BPB_TO_RGBA8 XeR5G6B5ToRGBA8
+#include "texture_load_16bpb_rgba8_rational.xesli"
