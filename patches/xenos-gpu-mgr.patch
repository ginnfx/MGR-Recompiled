diff --git a/include/rex/graphics/util/scale_ratio.h b/include/rex/graphics/util/scale_ratio.h
new file mode 100644
index 0000000..ce6596c
--- /dev/null
+++ b/include/rex/graphics/util/scale_ratio.h
@@ -0,0 +1,141 @@
+// MGR port: exact per-axis draw resolution scale as a reduced ratio.
+//
+// The Xenos backend historically supports integer scales only. A ratio lets
+// 3/2 (1280x720 -> 1920x1080) be expressed without passing 1.5 through integer
+// interfaces. For an integer ratio every function here returns exactly what
+// the original integer multiplication or division returned; tests/
+// scale_ratio_test.cpp checks that equivalence. Edge transforms use 64-bit
+// intermediates and always map both edges of a range rather than an offset
+// and an extent independently, so adjacent ranges never overlap or leave gaps.
+#pragma once
+
+#include <cassert>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <string>
+#include <string_view>
+
+namespace rex::graphics {
+
+struct ScaleRatio {
+  uint32_t num = 1;
+  uint32_t den = 1;
+
+  static constexpr ScaleRatio Integer(uint32_t scale) { return {scale, 1}; }
+  // Scales the backend can lay out EDRAM tiles and resolve blocks for:
+  // 1, 2, 3 (existing) and 3/2. All scaled EDRAM tile dimensions (80x16
+  // samples) and resolve blocks (8x8 pixels) are even, so 3/2 maps them to
+  // whole host pixels.
+  static constexpr bool IsSupported(ScaleRatio r) {
+    return (r.den == 1 && r.num >= 1 && r.num <= 3) || (r.num == 3 && r.den == 2);
+  }
+
+  constexpr bool IsInteger() const { return den == 1; }
+  constexpr bool IsScaled() const { return num != den; }
+  // Whether `guest` maps to a whole number of host pixels.
+  constexpr bool MapsExactly(uint32_t guest) const { return uint64_t(guest) * num % den == 0; }
+
+  constexpr uint32_t ScaleFloor(uint32_t guest) const {
+    return uint32_t(uint64_t(guest) * num / den);
+  }
+  constexpr uint32_t ScaleCeil(uint32_t guest) const {
+    return uint32_t((uint64_t(guest) * num + den - 1) / den);
+  }
+  // Inverse mapping, host to guest pixels.
+  constexpr uint32_t UnscaleFloor(uint32_t host) const {
+    return uint32_t(uint64_t(host) * den / num);
+  }
+  constexpr uint32_t UnscaleCeil(uint32_t host) const {
+    return uint32_t((uint64_t(host) * den + num - 1) / num);
+  }
+  // For quantities that are whole host pixels at every supported scale (EDRAM
+  // tile and render-target geometry, 8-pixel resolve rectangles): asserts it.
+  constexpr uint32_t ScaleExact(uint32_t guest) const {
+    assert(MapsExactly(guest));
+    return ScaleFloor(guest);
+  }
+  constexpr float AsFloat() const { return float(num) / float(den); }
+  // For code paths that only support integer scales. Enforced in release
+  // builds too: using the numerator of 3/2 would silently scale by 3.
+  uint32_t RequireInteger(const char* what) const {
+    if (den != 1) {
+      std::fprintf(stderr, "FATAL: %s requires an integer draw resolution scale, got %u/%u\n",
+                   what, num, den);
+      std::abort();
+    }
+    return num;
+  }
+
+  constexpr bool operator==(const ScaleRatio& other) const {
+    return uint64_t(num) * other.den == uint64_t(other.num) * den;
+  }
+};
+
+// Host size of `guest` units spread over both axes (EDRAM bytes, resolve
+// memory): guest * (num_x * num_y) / (den_x * den_y), exact for whole tiles.
+constexpr uint64_t ScaleArea(ScaleRatio x, ScaleRatio y, uint64_t guest) {
+  const uint64_t den = uint64_t(x.den) * y.den;
+  assert(guest * x.num * y.num % den == 0);
+  return guest * x.num * y.num / den;
+}
+
+// Host range covering guest pixels [begin, end): the host pixels whose
+// centers fall inside the scaled range, per the top-left fill rule. For
+// integer scales this is exactly [begin * s, end * s).
+struct HostRange {
+  uint32_t begin, end;
+};
+constexpr HostRange ScaleRange(ScaleRatio ratio, uint32_t begin, uint32_t end) {
+  // Host pixel h has its center at h + 0.5; it is inside [b*r, e*r) when
+  // h >= b*r - 0.5 and h < e*r - 0.5, i.e. h = ceil(b*r - 0.5) .. ceil(e*r - 0.5).
+  // With r = num/den: ceil((2*b*num - den) / (2*den)).
+  auto first_center_at_or_after = [&](uint32_t guest) -> uint32_t {
+    const int64_t twice = int64_t(2) * guest * ratio.num - ratio.den;
+    if (twice <= 0) return 0;
+    return uint32_t((twice + 2 * ratio.den - 1) / (2 * ratio.den));
+  };
+  return {first_center_at_or_after(begin), first_center_at_or_after(end)};
+}
+
+// Host rectangle for a guest rectangle (scissors, clear and resolve rects):
+// both edges go through ScaleRange, so adjacent rectangles share host edges.
+struct HostRect {
+  uint32_t offset[2];
+  uint32_t extent[2];
+};
+constexpr HostRect ScaleRect(ScaleRatio ratio_x, ScaleRatio ratio_y, const uint32_t offset[2],
+                             const uint32_t extent[2]) {
+  const HostRange x = ScaleRange(ratio_x, offset[0], offset[0] + extent[0]);
+  const HostRange y = ScaleRange(ratio_y, offset[1], offset[1] + extent[1]);
+  return {{x.begin, y.begin}, {x.end - x.begin, y.end - y.begin}};
+}
+
+// Text form used by settings and status: "1", "2", "3" or "1.5".
+inline std::string FormatScaleRatio(ScaleRatio ratio) {
+  if (ratio.num == 3 && ratio.den == 2) return "1.5";
+  return std::to_string(ratio.den ? ratio.num / ratio.den : 0);
+}
+
+// Accepts the FormatScaleRatio forms, "3/2" and float spellings such as
+// "1.500000" (TOML floats); returns false for unsupported scales.
+inline bool ParseScaleRatio(std::string_view text, ScaleRatio& out) {
+  const std::string value(text);
+  char* end = nullptr;
+  const double scale = std::strtod(value.c_str(), &end);
+  if (value == "3/2") {
+    out = {3, 2};
+    return true;
+  }
+  if (end == value.c_str() || *end != '\0') return false;
+  for (const ScaleRatio candidate :
+       {ScaleRatio::Integer(1), ScaleRatio{3, 2}, ScaleRatio::Integer(2), ScaleRatio::Integer(3)}) {
+    if (scale == double(candidate.num) / double(candidate.den)) {
+      out = candidate;
+      return true;
+    }
+  }
+  return false;
+}
+
+}  // namespace rex::graphics
diff --git a/include/rex/graphics/util/scaled_texture_address.h b/include/rex/graphics/util/scaled_texture_address.h
new file mode 100644
index 0000000..39f0752
--- /dev/null
+++ b/include/rex/graphics/util/scaled_texture_address.h
@@ -0,0 +1,79 @@
+// MGR port: CPU reference for addressing resolution-scaled resolve memory.
+//
+// Scaled resolve memory stores every guest texture "group" (the largest block
+// of texels that is contiguous in the guest tiled layout: 16x8, 16x4, 16x2,
+// 4x2 or 2x2 blocks for 1/2/4/8/16 bytes per block, 128 or 64 bytes) as one
+// contiguous host region of (group bytes * scale area) at
+// (guest group address * scale area). Shaders (texture_address.xesli
+// XeniaTextureGetResolutionScaledAddressing) map a host texel position to its
+// guest group and the byte offset inside that region.
+//
+// Scale num/den per axis, den 1 or 2: the region holds num x num "host groups"
+// of (guest group size / den) blocks, column-major, each row-major. With den 1
+// this is the upstream Xenia integer layout, reproduced exactly. With 3/2 the
+// host groups are 8x4, 8x2, 8x1, 2x1 and 1x1 blocks (half the guest group per
+// axis, 3x3 of them per guest group). Each guest group maps independently, so
+// any group-aligned alias of resolved memory addresses the same bytes at every
+// scale, and every host-group row stays contiguous for the shaders' multi-texel
+// loads and stores.
+#pragma once
+
+#include <cstdint>
+
+#include <rex/graphics/util/scale_ratio.h>
+
+namespace rex::graphics {
+
+struct ScaledGroupBlocksLog2 {
+  uint32_t x, y;
+};
+// XeniaTextureResolutionScaledGroupBlocksLog2.
+constexpr ScaledGroupBlocksLog2 GetScaledGroupBlocksLog2(uint32_t bytes_per_block_log2) {
+  return {bytes_per_block_log2 >= 3 ? 5 - bytes_per_block_log2 : 4,
+          3 - (bytes_per_block_log2 < 2 ? bytes_per_block_log2 : 2)};
+}
+
+struct ScaledTexelAddressing {
+  uint32_t guest_group_origin[2];  // in guest blocks
+  uint32_t host_byte_offset_in_guest_group;
+};
+
+constexpr uint32_t ScaleDenLog2(ScaleRatio scale) {
+  assert(scale.den == 1 || scale.den == 2);
+  return scale.den == 2 ? 1 : 0;
+}
+
+// Host group size: the guest group divided by the scale denominator.
+constexpr ScaledGroupBlocksLog2 GetScaledHostGroupBlocksLog2(ScaleRatio scale_x,
+                                                            ScaleRatio scale_y,
+                                                            uint32_t bytes_per_block_log2) {
+  const ScaledGroupBlocksLog2 group_log2 = GetScaledGroupBlocksLog2(bytes_per_block_log2);
+  return {group_log2.x - ScaleDenLog2(scale_x), group_log2.y - ScaleDenLog2(scale_y)};
+}
+
+// `position` is the host block position in the scaled texture.
+constexpr ScaledTexelAddressing GetScaledTexelAddressing(const uint32_t position[2],
+                                                         ScaleRatio scale_x, ScaleRatio scale_y,
+                                                         uint32_t bytes_per_block_log2) {
+  const ScaledGroupBlocksLog2 group_log2 = GetScaledGroupBlocksLog2(bytes_per_block_log2);
+  const ScaledGroupBlocksLog2 host_log2 =
+      GetScaledHostGroupBlocksLog2(scale_x, scale_y, bytes_per_block_log2);
+  const uint32_t sx = scale_x.num, sy = scale_y.num;
+  const uint32_t host_group[2] = {position[0] >> host_log2.x, position[1] >> host_log2.y};
+  const uint32_t guest_group[2] = {host_group[0] / sx, host_group[1] / sy};
+  const uint32_t in_guest[2] = {host_group[0] - sx * guest_group[0],
+                                host_group[1] - sy * guest_group[1]};
+  ScaledTexelAddressing out{};
+  out.guest_group_origin[0] = guest_group[0] << group_log2.x;
+  out.guest_group_origin[1] = guest_group[1] << group_log2.y;
+  const uint32_t host_group_index = in_guest[0] * sy + in_guest[1];
+  const uint32_t host_group_width_bytes_log2 = host_log2.x + bytes_per_block_log2;
+  const uint32_t in_host_group[2] = {position[0] & ((1u << host_log2.x) - 1),
+                                     position[1] & ((1u << host_log2.y) - 1)};
+  out.host_byte_offset_in_guest_group =
+      (host_group_index << (host_group_width_bytes_log2 + host_log2.y)) |
+      (in_host_group[1] << host_group_width_bytes_log2) | (in_host_group[0] << bytes_per_block_log2);
+  return out;
+}
+
+}  // namespace rex::graphics
diff --git a/include/rex/graphics/util/scaled_viewport.h b/include/rex/graphics/util/scaled_viewport.h
new file mode 100644
index 0000000..0ecffed
--- /dev/null
+++ b/include/rex/graphics/util/scaled_viewport.h
@@ -0,0 +1,96 @@
+// MGR port: per-axis host viewport math of draw_util::GetHostViewportInfo,
+// generalized from an integer draw resolution scale to a ScaleRatio.
+//
+// Host viewport bounds stay integers (see ViewportInfo); everything fractional
+// goes into ndc_scale / ndc_offset. For an integer ratio both functions run
+// the original arithmetic unchanged, so results are bit-identical to the code
+// they replace (tests/scaled_viewport_test.cpp). For a fractional ratio the
+// host bounds come from ScaleRange (pixel-center coverage of whole guest
+// pixels) and the NDC transform maps guest coordinates exactly onto
+// host = guest * ratio within those bounds.
+#pragma once
+
+#include <cmath>
+#include <cstdint>
+
+#include <rex/graphics/util/scale_ratio.h>
+#include <rex/math.h>
+
+namespace rex::graphics::draw_util {
+
+struct HostViewportAxis {
+  uint32_t offset;
+  uint32_t extent;
+  float ndc_scale;
+  float ndc_offset;
+};
+
+// Clipping enabled. `offset_axis` already includes the window and half-pixel
+// offsets; bounds are computed in whole guest pixels, then scaled.
+inline HostViewportAxis ScaleClippedViewportAxis(ScaleRatio ratio, float offset_axis,
+                                                 float scale_axis, uint32_t axis_max_unscaled) {
+  float scale_axis_abs = std::abs(scale_axis);
+  float axis_max_unscaled_float = float(axis_max_unscaled);
+  uint32_t axis_0_int =
+      uint32_t(rex::clamp_float(offset_axis - scale_axis_abs, 0.0f, axis_max_unscaled_float));
+  uint32_t axis_1_int =
+      uint32_t(rex::clamp_float(offset_axis + scale_axis_abs, 0.0f, axis_max_unscaled_float));
+  uint32_t axis_extent_int = axis_1_int - axis_0_int;
+  HostViewportAxis out;
+  if (ratio.IsInteger()) {
+    out.offset = axis_0_int * ratio.num;
+    out.extent = axis_extent_int * ratio.num;
+    if (axis_extent_int) {
+      float axis_extent_rounded = float(axis_extent_int);
+      out.ndc_scale = scale_axis * 2.0f / axis_extent_rounded;
+      out.ndc_offset = (float(offset_axis) - (float(axis_0_int) + axis_extent_rounded * 0.5f)) *
+                       2.0f / axis_extent_rounded;
+    } else {
+      out.ndc_scale = 1.0f;
+      out.ndc_offset = 0.0f;
+    }
+    return out;
+  }
+  const HostRange host = ScaleRange(ratio, axis_0_int, axis_1_int);
+  out.offset = host.begin;
+  out.extent = host.end - host.begin;
+  if (out.extent) {
+    const float ratio_float = ratio.AsFloat();
+    const float extent = float(out.extent);
+    out.ndc_scale = scale_axis * ratio_float * 2.0f / extent;
+    out.ndc_offset =
+        (offset_axis * ratio_float - (float(host.begin) + extent * 0.5f)) * 2.0f / extent;
+  } else {
+    out.ndc_scale = 1.0f;
+    out.ndc_offset = 0.0f;
+  }
+  return out;
+}
+
+// Clipping disabled: a viewport covering [0, extent_axis_unscaled) guest
+// pixels, with pixel offsetting done in NDC.
+inline HostViewportAxis ScaleUnclippedViewportAxis(ScaleRatio ratio, float scale_axis,
+                                                   float offset_base_axis, float offset_add_axis,
+                                                   uint32_t extent_axis_unscaled) {
+  HostViewportAxis out;
+  out.offset = 0;
+  if (ratio.IsInteger()) {
+    out.extent = extent_axis_unscaled * ratio.num;
+    float extent_axis_unscaled_float = float(extent_axis_unscaled);
+    float pixels_to_ndc_axis = 2.0f / extent_axis_unscaled_float;
+    out.ndc_scale = scale_axis * pixels_to_ndc_axis;
+    out.ndc_offset =
+        (offset_base_axis - extent_axis_unscaled_float * 0.5f + offset_add_axis) *
+        pixels_to_ndc_axis;
+    return out;
+  }
+  out.extent = ratio.ScaleFloor(extent_axis_unscaled);
+  const float ratio_float = ratio.AsFloat();
+  const float extent = float(out.extent);
+  out.ndc_scale = scale_axis * ratio_float * 2.0f / extent;
+  out.ndc_offset = ((offset_base_axis + offset_add_axis) * ratio_float - extent * 0.5f) *
+                   2.0f / extent;
+  return out;
+}
+
+}  // namespace rex::graphics::draw_util
