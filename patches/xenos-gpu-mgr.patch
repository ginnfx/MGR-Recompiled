+                                                 bool is_signed) {
+  const TextureBinding* binding = GetValidTextureBinding(fetch_constant_index);
+  if (!binding) {
+    return VK_NULL_HANDLE;
+  }
+  bool use_signed = is_signed && texture_util::IsAnySignSigned(binding->swizzled_signs);
+  Texture* texture = (use_signed && IsSignedVersionSeparateForFormat(binding->key))
+                         ? binding->texture_signed
+                         : binding->texture;
+  if (!texture) {
+    return VK_NULL_HANDLE;
+  }
+  auto* vulkan_texture = static_cast<VulkanTexture*>(texture);
+  xenos::DataDimension data_dimension = binding->key.dimension;
+  switch (dimension) {
+    case xenos::FetchOpDimension::k1D:
+    case xenos::FetchOpDimension::k2D:
+      if (data_dimension == xenos::DataDimension::k3D) {
+        return vulkan_texture->GetOrCreate3DAs2DImageView(use_signed, binding->host_swizzle);
+      }
+      if (data_dimension != xenos::DataDimension::k1D &&
+          data_dimension != xenos::DataDimension::k2DOrStacked) {
+        return VK_NULL_HANDLE;
+      }
+      return vulkan_texture->GetView(use_signed, binding->host_swizzle, false);
+    case xenos::FetchOpDimension::k3DOrStacked:
+      return data_dimension == xenos::DataDimension::k3D
+                 ? vulkan_texture->GetView(use_signed, binding->host_swizzle, false)
+                 : VK_NULL_HANDLE;
+    case xenos::FetchOpDimension::kCube:
+      return data_dimension == xenos::DataDimension::kCube
+                 ? vulkan_texture->GetView(use_signed, binding->host_swizzle, false)
+                 : VK_NULL_HANDLE;
+  }
+  return VK_NULL_HANDLE;
+}
