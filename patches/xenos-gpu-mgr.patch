+const char* VulkanCommandProcessor::MgrSelectNativePixelShader(
+    const VulkanShader* pixel_shader, uint32_t interpolator_mask, bool memexport_used_pixel,
+    uint32_t normalized_color_mask, VkShaderModule& module_out, uint32_t& spec_constants_out,
+    float& alpha_threshold_out) {
+  module_out = VK_NULL_HANDLE;
+  spec_constants_out = 0;
+  alpha_threshold_out = 0.0f;
+  if (!pixel_shader || !native_ps_.enabled()) {
+    return "disabled";
+  }
+  if (memexport_used_pixel) {
+    return "memexport";
+  }
+  if (render_target_cache_->GetPath() != RenderTargetCache::Path::kHostRenderTargets) {
+    return "fsi";
+  }
+  const mgr_native::PixelShader* native = native_ps_.Find(pixel_shader->ucode_data_hash());
+  if (!native) {
+    return "no_shader";
+  }
+  const uint32_t flags = system_constants_.flags;
+  const uint32_t gamma_flags = SpirvShaderTranslator::kSysFlag_ConvertColor0ToGamma |
+                               SpirvShaderTranslator::kSysFlag_ConvertColor1ToGamma |
+                               SpirvShaderTranslator::kSysFlag_ConvertColor2ToGamma |
+                               SpirvShaderTranslator::kSysFlag_ConvertColor3ToGamma;
+  if (flags & gamma_flags) {
+    return "gamma";
+  }
+  // Xenia emulates alpha-to-coverage in its translated pixel shader; the
+  // native shaders have no equivalent.
+  if (system_constants_.alpha_to_mask) {
+    return "alpha_to_mask";
+  }
+  // Without view swizzles Xenia swizzles in the shader (texture_swizzles);
+  // native shaders rely on the view swizzle.
+  if (!GetVulkanDevice()->properties().imageViewFormatSwizzle) {
+    return "no_view_swizzle";
+  }
+  auto alpha_function = xenos::CompareFunction(
+      (flags >> SpirvShaderTranslator::kSysFlag_AlphaPassIfLess_Shift) & 0b111);
+  if (alpha_function != xenos::CompareFunction::kAlways) {
+    if (!(native->spec_constants_mask & mgr_native::kSpecConstantAlphaTest)) {
+      return "alpha_unsupported";
+    }
+    // XenosRecomp's alpha test is clip(alpha - threshold): pass if >= threshold.
+    if (alpha_function == xenos::CompareFunction::kGreaterEqual) {
+      alpha_threshold_out = system_constants_.alpha_test_reference;
+    } else if (alpha_function == xenos::CompareFunction::kGreater) {
+      alpha_threshold_out = std::nextafter(system_constants_.alpha_test_reference, INFINITY);
+    } else {
+      return "alpha_func";
+    }
+    spec_constants_out |= mgr_native::kSpecConstantAlphaTest;
+  }
+  for (uint32_t i = 0; i < xenos::kMaxColorRenderTargets; ++i) {
+    if (((normalized_color_mask >> (4 * i)) & 0b1111) &&
+        system_constants_.color_exp_bias[i] != 1.0f) {
+      return "exp_bias";
+    }
+  }
+  native_texture_views_.clear();
+  for (const auto& binding : pixel_shader->GetTextureBindingsAfterTranslation()) {
+    if (binding.fetch_constant >= mgr_native::kSlotCount) {
+      return "tex_slot";
+    }
+    uint8_t signs = texture_cache_->GetActiveTextureSwizzledSigns(binding.fetch_constant);
+    for (uint32_t component = 0; component < 4; ++component) {
+      auto sign = xenos::TextureSign((signs >> (2 * component)) & 0b11);
+      if (sign == xenos::TextureSign::kUnsignedBiased || sign == xenos::TextureSign::kGamma) {
+        return "tex_sign";
+      }
+    }
+    if (texture_util::IsAnySignSigned(signs) && texture_util::IsAnySignNotSigned(signs)) {
+      return "tex_sign_mixed";
+    }
+    VkImageView view = texture_cache_->MgrGetNativeView(binding.fetch_constant, binding.dimension,
+                                                         bool(binding.is_signed));
+    if (view == VK_NULL_HANDLE) {
+      return "tex_view";
+    }
+    uint32_t descriptor_binding;
+    switch (binding.dimension) {
+      case xenos::FetchOpDimension::k3DOrStacked:
+        descriptor_binding = mgr_native::kBindingTextures3D;
+        break;
+      case xenos::FetchOpDimension::kCube:
+        descriptor_binding = mgr_native::kBindingTexturesCube;
+        break;
+      default:
+        descriptor_binding = mgr_native::kBindingTextures2D;
+        break;
+    }
+    native_texture_views_.push_back({binding.fetch_constant, descriptor_binding, view});
+  }
+  // Native samplers are indexed by fetch constant, so two Xenia sampler
+  // bindings on one slot (different filter overrides) would collide.
+  uint32_t sampler_slots_used = 0;
+  for (const auto& binding : pixel_shader->GetSamplerBindingsAfterTranslation()) {
+    if (binding.fetch_constant >= mgr_native::kSlotCount) {
+      return "sampler_slot";
+    }
+    const uint32_t slot_bit = uint32_t(1) << binding.fetch_constant;
+    if (sampler_slots_used & slot_bit) {
+      return "sampler_shared_slot";
+    }
+    sampler_slots_used |= slot_bit;
+  }
+  module_out = native_ps_.GetModule(*native, interpolator_mask);
+  if (module_out == VK_NULL_HANDLE) {
+    return "interpolators";
+  }
+  return nullptr;
+}
