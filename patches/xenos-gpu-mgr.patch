diff --git a/include/rex/graphics/vulkan/mgr_cmd_stats.h b/include/rex/graphics/vulkan/mgr_cmd_stats.h
new file mode 100644
index 0000000..524eafa
--- /dev/null
+++ b/include/rex/graphics/vulkan/mgr_cmd_stats.h
@@ -0,0 +1,43 @@
+// MGR port diagnostic: counts recorded Vulkan commands per call site.
+// Enabled with MGR_GPU_STATS=1; prints a per-frame breakdown every few seconds.
+#pragma once
+
+namespace rex::graphics::vulkan::mgr_stats {
+
+enum class Kind {
+  kBeginRenderPass,
+  kBeginRendering,
+  kDispatch,
+  kCopyBuffer,
+  kCopyBufferToImage,
+  kBarrier,
+  kDraw,
+  kClearAttachments,
+  kSubmission,
+  kCount
+};
+
+bool Enabled();
+void AddBusyNanoseconds(long long ns);
+void AddWaitNanoseconds(long long ns);  // blocking GPU fence waits (subset of busy)
+long long NowNanoseconds();
+
+// Accumulates GPU command processor busy time (reported per frame).
+struct BusyScope {
+  long long start = Enabled() ? NowNanoseconds() : 0;
+  ~BusyScope() {
+    if (start) AddBusyNanoseconds(NowNanoseconds() - start);
+  }
+};
+void Record(Kind kind, const void* call_site);
+void OnFrame();
+
+}  // namespace rex::graphics::vulkan::mgr_stats
+
+#define MGR_STAT(kind)                                                         \
+  do {                                                                         \
+    if (::rex::graphics::vulkan::mgr_stats::Enabled())                         \
+      ::rex::graphics::vulkan::mgr_stats::Record(                              \
+          ::rex::graphics::vulkan::mgr_stats::Kind::kind,                      \
+          __builtin_return_address(0));                                        \
+  } while (0)
diff --git a/include/rex/graphics/vulkan/mgr_native_ps.h b/include/rex/graphics/vulkan/mgr_native_ps.h
new file mode 100644
index 0000000..536e5b5
--- /dev/null
+++ b/include/rex/graphics/vulkan/mgr_native_ps.h
@@ -0,0 +1,105 @@
+// MGR port: native pixel shaders (offline XenosRecomp) for the Xenos Vulkan backend.
+//
+// Draws keep Xenia's translated vertex shader, render target cache, texture
+// cache and primitive processing; the pixel stage uses an offline-recompiled
+// shader from the MGR native bundle (tools: XenosRecomp, patches/xenosrecomp-mgr.patch).
+// Descriptor set 3 (Xenia's pixel texture set) is replaced by the native set:
+//   binding 0: storage buffer, 256 float4 pixel shader constants (host endian)
+//   binding 1: storage buffer, shared constants (booleans at 512, alpha ref at 556)
+//   binding 2/3/4: sampled image arrays [32] (2D / 3D / cube), index = fetch constant
+//   binding 5: sampler array [32]
+#pragma once
+
+#include <cstdint>
+#include <memory>
+#include <string>
+#include <unordered_map>
+#include <vector>
+
+#include <rex/ui/vulkan/api.h>
+
+namespace rex::ui::vulkan {
+class VulkanDevice;
+class VulkanUploadBufferPool;
+}  // namespace rex::ui::vulkan
+
+namespace rex::graphics::vulkan::mgr_native {
+
+constexpr uint32_t kSlotCount = 32;
+constexpr uint32_t kPixelConstantsBytes = 256 * 16;
+constexpr uint32_t kSharedConstantsBytes = 592;
+constexpr uint32_t kSharedBooleansOffset = 512;
+constexpr uint32_t kSharedAlphaThresholdOffset = 556;
+constexpr uint32_t kSpecConstantAlphaTest = 1u << 1;  // SPEC_CONSTANT_ALPHA_TEST
+
+enum Binding : uint32_t {
+  kBindingPixelConstants,
+  kBindingSharedConstants,
+  kBindingTextures2D,
+  kBindingTextures3D,
+  kBindingTexturesCube,
+  kBindingSamplers,
+  kBindingCount
+};
+
+struct PixelShader {
+  uint64_t ucode_hash = 0;
+  uint32_t spec_constants_mask = 0;
+  uint32_t input_register_mask = 0;            // interpolator registers read
+  std::vector<uint32_t> spirv;                  // location literal = register
+  std::vector<uint32_t> input_location_words;   // word indices of input Location literals
+};
+
+class NativePixelShaders {
+ public:
+  bool Initialize(const ui::vulkan::VulkanDevice* device);
+  void Shutdown();
+  bool enabled() const { return enabled_; }
+
+  const PixelShader* Find(uint64_t ucode_hash) const;
+  // Module with input locations remapped to the packed rank within
+  // interpolator_mask (Xenia's vertex shader output layout). Null if the shader
+  // reads a register outside the mask.
+  VkShaderModule GetModule(const PixelShader& shader, uint32_t interpolator_mask);
+
+  VkDescriptorSetLayout set_layout() const { return set_layout_; }
+
+  // Per-frame transient resources (frame indices from the command processor).
+  void Reclaim(uint64_t completed_frame);
+  void FlushWrites();
+  VkDescriptorSet AllocateSet(uint64_t frame);
+  uint8_t* RequestUpload(uint64_t frame, size_t size, VkBuffer& buffer, VkDeviceSize& offset);
+
+  // Coverage statistics (MGR_GPU_STATS).
+  void CountDraw(bool native, const char* fallback_reason);
+  void CountBindings(bool pixel_upload, bool shared_upload, bool set_reused);
+
+ private:
+  bool LoadBundle(const std::string& path);
+  VkDescriptorPool CreatePool();
+
+  const ui::vulkan::VulkanDevice* device_ = nullptr;
+  bool enabled_ = false;
+  std::unordered_map<uint64_t, PixelShader> shaders_;
+  std::unordered_map<uint64_t, VkShaderModule> modules_;  // key: hash ^ mask mix
+  VkDescriptorSetLayout set_layout_ = VK_NULL_HANDLE;
+
+  struct FramePools {
+    uint64_t frame;
+    std::vector<VkDescriptorPool> pools;
+  };
+  std::vector<FramePools> used_pools_;
+  std::vector<VkDescriptorPool> free_pools_;
+  VkDescriptorPool current_pool_ = VK_NULL_HANDLE;
+  uint64_t current_pool_frame_ = UINT64_MAX;
+
+  std::unique_ptr<ui::vulkan::VulkanUploadBufferPool> upload_pool_;
+  size_t storage_alignment_ = 16;
+
+  uint64_t native_draws_ = 0;
+  uint64_t fallback_draws_ = 0;
+  uint64_t pixel_uploads_ = 0, shared_uploads_ = 0, sets_written_ = 0, sets_reused_ = 0;
+  std::unordered_map<std::string, uint64_t> fallback_reasons_;
+};
+
+}  // namespace rex::graphics::vulkan::mgr_native
diff --git a/include/rex/graphics/vulkan/pipeline_cache.h b/include/rex/graphics/vulkan/pipeline_cache.h
