+
 bool VulkanSharedMemory::UploadRanges(
     const std::vector<std::pair<uint32_t, uint32_t>>& upload_page_ranges) {
   if (upload_page_ranges.empty()) {
     return true;
   }
+  if (direct_mapping_) {
+    // A page may be overwritten from the CPU only if every submission that
+    // accessed it (draw/texture reads, resolves, earlier ordered copies) has
+    // completed on the GPU; otherwise keep Xenia's ordered transfer.
+    uint64_t completed = command_processor_.GetCompletedSubmission();
+    const uint64_t current = command_processor_.GetCurrentSubmission();
+    // Refresh GPU progress (non-blocking) only when it could change the outcome.
+    bool needs_poll = false;
+    for (auto upload_range : upload_page_ranges) {
+      for (uint32_t page = upload_range.first;
+           page < upload_range.first + upload_range.second && !needs_poll; ++page) {
+        const uint64_t last = page_last_access_submission_[page];
+        needs_poll = last > completed && last < current;
+      }
+      if (needs_poll) break;
+    }
+    if (needs_poll) {
+      completed = command_processor_.PollCompletedSubmission();
+    }
+    std::vector<std::pair<uint32_t, uint32_t>> copy_ranges;
+    for (auto upload_range : upload_page_ranges) {
+      uint32_t page = upload_range.first;
+      const uint32_t page_end = upload_range.first + upload_range.second;
+      for (uint32_t p = page; UploadStatsEnabled() && p < page_end; ++p) {
+        const uint64_t last = page_last_access_submission_[p];
+        if (last == current) {
+          ++copied_same_submission_pages_;
+        } else if (last > completed) {
+          ++copied_in_flight_pages_;
+        }
+      }
+      while (page < page_end) {
+        const bool direct = page_last_access_submission_[page] <= completed;
+        uint32_t run_end = page + 1;
+        while (run_end < page_end &&
+               (page_last_access_submission_[run_end] <= completed) == direct) {
+          ++run_end;
+        }
+        const uint32_t offset = page << page_size_log2();
+        const uint32_t length = (run_end - page) << page_size_log2();
+        if (direct) {
+          MakeRangeValid(offset, length, false);
+          std::memcpy(direct_mapping_ + offset, memory().TranslatePhysical(offset), length);
+          direct_upload_pages_ += run_end - page;
+          page = run_end;
+          continue;
+        }
+        // Not idle: split into pages untouched by this submission (hoistable to
+        // its start) and pages it already accessed (must stay in order).
+        for (uint32_t p = page; p < run_end;) {
+          const bool hoistable = page_last_access_submission_[p] != current;
+          uint32_t sub_end = p + 1;
+          while (sub_end < run_end &&
+                 (page_last_access_submission_[sub_end] != current) == hoistable) {
+            ++sub_end;
+          }
+          if (hoistable && StageHoistedUpload(p, sub_end - p)) {
+            hoisted_upload_pages_ += sub_end - p;
+          } else {
+            copy_ranges.emplace_back(p, sub_end - p);
+            copied_upload_pages_ += sub_end - p;
+          }
+          p = sub_end;
+        }
+        page = run_end;
+      }
+    }
+    ReportUploadStats();
+    return copy_ranges.empty() || UploadRangesWithCopies(copy_ranges);
+  }
+  return UploadRangesWithCopies(upload_page_ranges);
+}
+
+bool VulkanSharedMemory::StageHoistedUpload(uint32_t page_start, uint32_t page_count) {
+  const uint64_t submission_current = command_processor_.GetCurrentSubmission();
+  while (page_count) {
+    VkBuffer upload_buffer;
+    VkDeviceSize upload_buffer_offset, upload_buffer_size;
+    uint8_t* mapping = upload_buffer_pool_->RequestPartial(
+        submission_current, page_count << page_size_log2(), size_t(1) << page_size_log2(),
+        upload_buffer, upload_buffer_offset, upload_buffer_size);
+    if (!mapping) {
+      return false;  // caller falls back to the ordered inline copy
+    }
+    const uint32_t offset = page_start << page_size_log2();
+    MakeRangeValid(offset, uint32_t(upload_buffer_size), false);
+    std::memcpy(mapping, memory().TranslatePhysical(offset), upload_buffer_size);
+    VkBufferCopy region;
+    region.srcOffset = upload_buffer_offset;
+    region.dstOffset = offset;
+    region.size = upload_buffer_size;
+    hoisted_uploads_.emplace_back(upload_buffer, region);
+    MarkPagesAccessed(offset, uint32_t(upload_buffer_size));
+    const uint32_t pages = uint32_t(upload_buffer_size >> page_size_log2());
+    page_start += pages;
+    page_count -= pages;
+  }
+  return true;
+}
+
+void VulkanSharedMemory::RecordHoistedUploads(VkCommandBuffer command_buffer) {
+  if (hoisted_uploads_.empty()) {
+    return;
+  }
+  const ui::vulkan::VulkanDevice::Functions& dfn = command_processor_.GetVulkanDevice()->functions();
+  // Older submissions' reads/writes of these pages -> our transfer writes.
+  VkMemoryBarrier barrier = {};
+  barrier.sType = VK_STRUCTURE_TYPE_MEMORY_BARRIER;
+  barrier.srcAccessMask = VK_ACCESS_SHADER_WRITE_BIT | VK_ACCESS_TRANSFER_WRITE_BIT;
+  barrier.dstAccessMask = VK_ACCESS_TRANSFER_WRITE_BIT;
+  dfn.vkCmdPipelineBarrier(command_buffer, VK_PIPELINE_STAGE_ALL_COMMANDS_BIT,
+                           VK_PIPELINE_STAGE_TRANSFER_BIT, 0, 1, &barrier, 0, nullptr, 0,
+                           nullptr);
+  std::vector<VkBufferCopy> regions;
+  for (size_t i = 0; i < hoisted_uploads_.size();) {
+    const VkBuffer source = hoisted_uploads_[i].first;
+    regions.clear();
+    for (; i < hoisted_uploads_.size() && hoisted_uploads_[i].first == source; ++i) {
+      regions.push_back(hoisted_uploads_[i].second);
+    }
+    dfn.vkCmdCopyBuffer(command_buffer, source, buffer_, uint32_t(regions.size()),
+                        regions.data());
+  }
+  // Our transfer writes -> any later access in this submission.
+  barrier.srcAccessMask = VK_ACCESS_TRANSFER_WRITE_BIT;
+  barrier.dstAccessMask = VK_ACCESS_INDEX_READ_BIT | VK_ACCESS_SHADER_READ_BIT |
+                          VK_ACCESS_SHADER_WRITE_BIT | VK_ACCESS_TRANSFER_READ_BIT |
+                          VK_ACCESS_TRANSFER_WRITE_BIT;
+  dfn.vkCmdPipelineBarrier(command_buffer, VK_PIPELINE_STAGE_TRANSFER_BIT,
+                           VK_PIPELINE_STAGE_ALL_COMMANDS_BIT, 0, 1, &barrier, 0, nullptr, 0,
+                           nullptr);
+  hoisted_uploads_.clear();
+}
+
+void VulkanSharedMemory::ReportUploadStats() {
+  constexpr uint64_t REPORT_EVERY_PAGES = 200000;
+  if (!UploadStatsEnabled() ||
+      direct_upload_pages_ + copied_upload_pages_ + hoisted_upload_pages_ < REPORT_EVERY_PAGES) {
+    return;
+  }
+  REXGPU_INFO("Shared memory uploads: {} pages direct, {} pages copied ({:.1f}% direct)",
+              direct_upload_pages_, copied_upload_pages_,
+              100.0 * double(direct_upload_pages_) /
+                  double(direct_upload_pages_ + copied_upload_pages_));
+  std::fprintf(stderr,
+               "[mgr-gpu] uploads: %llu pages direct, %llu hoisted, %llu inline-copied "
+               "(%.1f%% direct); fallback seen: same submission %llu, older in-flight %llu\n",
+               (unsigned long long)direct_upload_pages_, (unsigned long long)hoisted_upload_pages_,
+               (unsigned long long)copied_upload_pages_,
+               100.0 * double(direct_upload_pages_) /
+                   double(direct_upload_pages_ + copied_upload_pages_),
+               (unsigned long long)copied_same_submission_pages_,
+               (unsigned long long)copied_in_flight_pages_);
+  direct_upload_pages_ = copied_upload_pages_ = hoisted_upload_pages_ = 0;
+  copied_same_submission_pages_ = copied_in_flight_pages_ = 0;
+}
