+    const PrimitiveProcessor::ProcessingResult& primitive_processing_result,
+    reg::RB_DEPTHCONTROL normalized_depth_control, uint32_t normalized_color_mask,
+    VulkanRenderTargetCache::RenderPassKey render_pass_key, VkShaderModule native_pixel_shader,
+    uint32_t native_spec_constants, const PipelineLayoutProvider* native_layout,
+    const NativePipelineInputs& native_inputs, VkPipeline& pipeline_out) {
+  pipeline_out = VK_NULL_HANDLE;
+  if (!EnsureShadersTranslated(vertex_shader, pixel_shader)) {
+    return false;
+  }
+  PipelineDescription description;
+  if (!GetCurrentStateDescription(vertex_shader, pixel_shader, primitive_processing_result,
+                                  normalized_depth_control, normalized_color_mask, render_pass_key,
+                                  description)) {
+    return false;
+  }
+  NativePipelineKey key{description, native_pixel_shader, native_spec_constants};
+  if (last_native_pipeline_ && last_native_pipeline_->first == key) {
+    pipeline_out = last_native_pipeline_->second->second.pipeline.load(std::memory_order_acquire);
+    return pipeline_out != VK_NULL_HANDLE;
+  }
+  auto it = native_pipelines_.find(key);
+  if (it == native_pipelines_.end()) {
+    auto storage =
+        std::make_unique<std::pair<const PipelineDescription, Pipeline>>(description, Pipeline());
+    PipelineCreationArguments creation_arguments;
+    if (TryGetPipelineCreationArgumentsForDescription(description, storage.get(),
+                                                      creation_arguments)) {
+      creation_arguments.pipeline_layout = native_layout;
+      creation_arguments.native_pixel_shader = native_pixel_shader;
+      creation_arguments.native_spec_constants = native_spec_constants;
+      if (REXCVAR_GET(async_shader_compilation) && !creation_threads_.empty()) {
+        // Metal compiles on a worker; until then (and after a failure) the
+        // null pipeline makes the draw use the Xenia pipeline - no stall.
+        {
+          std::lock_guard<std::mutex> lock(creation_request_lock_);
+          native_creation_queue_.push_back(creation_arguments);
+        }
+        creation_request_cond_.notify_one();
+      } else {
+        CreateNativePipeline(creation_arguments);
+      }
+      AppendNativePipelineRecord(description, native_inputs, native_spec_constants);
+    }
+    // Failures stay cached as a null pipeline so the draw falls back to Xenia
+    // without retrying every frame.
+    it = native_pipelines_.emplace(key, std::move(storage)).first;
+  }
+  last_native_pipeline_ = &*it;
+  pipeline_out = it->second->second.pipeline.load(std::memory_order_acquire);
+  return pipeline_out != VK_NULL_HANDLE;
+}
