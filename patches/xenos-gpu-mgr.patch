+class MgrEffectCpuScope {
+ public:
+  MgrEffectCpuScope(mgr_timing::GpuTimer& timer, const uint64_t& tag, bool copy)
+      : timer_(timer.zones_enabled() ? &timer : nullptr), tag_(tag), copy_(copy) {
+    if (timer_) start_ = std::chrono::steady_clock::now();
+  }
+  ~MgrEffectCpuScope() {
+    if (!timer_) return;
+    const auto elapsed = std::chrono::steady_clock::now() - start_;
+    timer_->AddCpu(tag_,
+                   uint64_t(std::chrono::duration_cast<std::chrono::nanoseconds>(elapsed).count()),
+                   copy_);
+  }
+  MgrEffectCpuScope(const MgrEffectCpuScope&) = delete;
+  MgrEffectCpuScope& operator=(const MgrEffectCpuScope&) = delete;
+
+ private:
+  mgr_timing::GpuTimer* timer_;
+  const uint64_t& tag_;
+  bool copy_;
+  std::chrono::steady_clock::time_point start_;
+};
