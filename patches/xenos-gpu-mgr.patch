+  // TODO(Triang3l): Investigate formats 8_A and 8_B.
+  byte_buffer_align4_store4_xe(
+      xe_resolve_dest, XeResolveDestPixelAddress(resolve_info, pixel_index, 0u),
+      XePackR8G8B8A8UNorm(pixels_0123));
+  dont_flatten_xe
+  if (pixel_index.x + 4u < resolve_info.width_scaled) {
+    byte_buffer_align4_store4_xe(
+        xe_resolve_dest,
+        XeResolveDestPixelAddress(resolve_info, pixel_index + uint2_xe(4u, 0u),
+                                  0u),
+        XePackR8G8B8A8UNorm(pixels_4567));
+  }
+}
+entry_code_end_compute_xe
