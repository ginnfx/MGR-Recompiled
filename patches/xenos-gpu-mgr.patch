+/**
+ ******************************************************************************
+ * Xenia : Xbox 360 Emulator Research Project                                 *
+ ******************************************************************************
+ * Copyright 2022 Ben Vanik. All rights reserved.                             *
+ * Released under the BSD license - see LICENSE in the root for more details. *
+ ******************************************************************************
+ */
+
+// MGR port: source for the 3/2 versions of ReXGlue's hand-written
+// texture_load_r5g6b5_rgba8 and texture_load_r4g4b4a4_rgba8 SPIR-V: 16bpb guest
+// blocks expanded to 32bpp RGBA8 with XE_TEXTURE_LOAD_16BPB_TO_RGBA8(blocks),
+// which maps the 16-bit texel in each uint4 lane to a 32-bit one. 1 thread =
+// 16 blocks as in texture_load_16bpb.xesli; with a rational resolution scale
+// the second 8 blocks start the next host group and get their own address.
+
+#include "texture_load.xesli"
+
+XE_TEXTURE_LOAD_ENTRY(16)
+{
+  XeTextureLoadInfo load_info = XeTextureLoadGetInfo(pass_push_consts_xe);
+  uint3_xe block_index = in_global_thread_id_xe << uint3_xe(4u, 0u, 0u);
+  dont_flatten_xe
+  if (any(greater_than_equal_xe(block_index.xy, load_info.size_blocks.xy))) {
+    return;
+  }
+  uint block_offset_host =
+      load_info.host_offset +
+      uint(XeTextureHostLinearOffset(int3_xe(block_index), load_info.host_pitch,
+                                     load_info.size_blocks.y, 4u));
+  uint block_offset_guest =
+      XeTextureLoadSourceAddress(load_info, block_index, 1u);
+  uint4_xe guest_blocks = XeEndianSwap16(
+      byte_buffer_align16_load16_xe(xe_texture_load_source, block_offset_guest),
+      load_info.endian_32);
+  byte_buffer_align16_store16_xe(
+      xe_texture_load_dest, block_offset_host,
+      XE_TEXTURE_LOAD_16BPB_TO_RGBA8(uint4_xe(
+          guest_blocks.x & 0xFFFFu, guest_blocks.x >> 16u,
+          guest_blocks.y & 0xFFFFu, guest_blocks.y >> 16u)));
+  byte_buffer_align16_store16_xe(
+      xe_texture_load_dest, block_offset_host + 16u,
+      XE_TEXTURE_LOAD_16BPB_TO_RGBA8(uint4_xe(
+          guest_blocks.z & 0xFFFFu, guest_blocks.z >> 16u,
+          guest_blocks.w & 0xFFFFu, guest_blocks.w >> 16u)));
+  block_offset_guest = XeTextureLoadSourceAddress(
+      load_info, block_index + uint3_xe(8u, 0u, 0u), 1u);
+  guest_blocks = XeEndianSwap16(
+      byte_buffer_align16_load16_xe(xe_texture_load_source, block_offset_guest),
+      load_info.endian_32);
+  byte_buffer_align16_store16_xe(
+      xe_texture_load_dest, block_offset_host + 32u,
+      XE_TEXTURE_LOAD_16BPB_TO_RGBA8(uint4_xe(
+          guest_blocks.x & 0xFFFFu, guest_blocks.x >> 16u,
+          guest_blocks.y & 0xFFFFu, guest_blocks.y >> 16u)));
+  byte_buffer_align16_store16_xe(
+      xe_texture_load_dest, block_offset_host + 48u,
+      XE_TEXTURE_LOAD_16BPB_TO_RGBA8(uint4_xe(
+          guest_blocks.z & 0xFFFFu, guest_blocks.z >> 16u,
+          guest_blocks.w & 0xFFFFu, guest_blocks.w >> 16u)));
+}
+entry_code_end_compute_xe
