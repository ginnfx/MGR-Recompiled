+bool VulkanCommandProcessor::MgrBindNativePixelSet(const VulkanShader& pixel_shader,
+                                                   float alpha_threshold) {
+  const RegisterFile& regs = *register_file_;
+  VkDescriptorSet set = native_ps_.AllocateSet(frame_current_);
+  if (set == VK_NULL_HANDLE) {
+    return false;
+  }
+  VkDescriptorBufferInfo buffer_infos[2];
+  uint8_t* pixel_constants =
+      native_ps_.RequestUpload(frame_current_, mgr_native::kPixelConstantsBytes,
+                               buffer_infos[0].buffer, buffer_infos[0].offset);
+  uint8_t* shared_constants =
+      native_ps_.RequestUpload(frame_current_, mgr_native::kSharedConstantsBytes,
+                               buffer_infos[1].buffer, buffer_infos[1].offset);
+  if (!pixel_constants || !shared_constants) {
+    return false;
+  }
+  buffer_infos[0].range = mgr_native::kPixelConstantsBytes;
+  buffer_infos[1].range = mgr_native::kSharedConstantsBytes;
+  std::memcpy(pixel_constants, &regs[XE_GPU_REG_SHADER_CONSTANT_256_X],
+              mgr_native::kPixelConstantsBytes);
+  std::memset(shared_constants, 0, mgr_native::kSharedConstantsBytes);
+  std::memcpy(shared_constants + mgr_native::kSharedBooleansOffset,
+              &regs[XE_GPU_REG_SHADER_CONSTANT_BOOL_000_031], 8 * sizeof(uint32_t));
+  std::memcpy(shared_constants + mgr_native::kSharedAlphaThresholdOffset, &alpha_threshold,
+              sizeof(float));
+
+  const auto& samplers = pixel_shader.GetSamplerBindingsAfterTranslation();
+  native_image_infos_.clear();
+  native_image_infos_.reserve(native_texture_views_.size() + samplers.size());
+  native_writes_.clear();
+  for (uint32_t i = 0; i < 2; ++i) {
+    VkWriteDescriptorSet& write = native_writes_.emplace_back();
+    write = {VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET};
+    write.dstSet = set;
+    write.dstBinding = i;
+    write.descriptorCount = 1;
+    write.descriptorType = VK_DESCRIPTOR_TYPE_STORAGE_BUFFER;
+    write.pBufferInfo = &buffer_infos[i];
+  }
+  for (const NativeTextureView& texture : native_texture_views_) {
+    VkDescriptorImageInfo& info = native_image_infos_.emplace_back();
+    info = {VK_NULL_HANDLE, texture.view, VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL};
+    VkWriteDescriptorSet& write = native_writes_.emplace_back();
+    write = {VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET};
+    write.dstSet = set;
+    write.dstBinding = texture.binding;
+    write.dstArrayElement = texture.fetch_constant;
+    write.descriptorCount = 1;
+    write.descriptorType = VK_DESCRIPTOR_TYPE_SAMPLED_IMAGE;
+    write.pImageInfo = &info;
+  }
+  for (size_t i = 0; i < samplers.size() && i < current_samplers_pixel_.size(); ++i) {
+    VkDescriptorImageInfo& info = native_image_infos_.emplace_back();
+    info = {current_samplers_pixel_[i].second, VK_NULL_HANDLE, VK_IMAGE_LAYOUT_UNDEFINED};
+    VkWriteDescriptorSet& write = native_writes_.emplace_back();
+    write = {VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET};
+    write.dstSet = set;
+    write.dstBinding = mgr_native::kBindingSamplers;
+    write.dstArrayElement = samplers[i].fetch_constant;
+    write.descriptorCount = 1;
+    write.descriptorType = VK_DESCRIPTOR_TYPE_SAMPLER;
+    write.pImageInfo = &info;
+  }
+  const ui::vulkan::VulkanDevice* const vulkan_device = GetVulkanDevice();
+  vulkan_device->functions().vkUpdateDescriptorSets(vulkan_device->device(),
+                                                    uint32_t(native_writes_.size()),
+                                                    native_writes_.data(), 0, nullptr);
+  deferred_command_buffer_.CmdVkBindDescriptorSets(
+      VK_PIPELINE_BIND_POINT_GRAPHICS, current_guest_graphics_pipeline_layout_->GetPipelineLayout(),
+      SpirvShaderTranslator::kDescriptorSetTexturesPixel, 1, &set, 0, nullptr);
+  return true;
+}
