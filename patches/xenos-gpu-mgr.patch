+void VulkanSharedMemory::MarkPagesAccessed(uint32_t start, uint32_t length) {
+  if (!direct_mapping_ || !length) {
+    return;
+  }
+  const uint64_t submission = command_processor_.GetCurrentSubmission();
+  const uint32_t page_first = start >> page_size_log2();
+  const uint32_t page_end =
+      std::min(uint32_t((uint64_t(start) + length + (uint64_t(1) << page_size_log2()) - 1) >>
+                        page_size_log2()),
+               uint32_t(page_last_access_submission_.size()));
+  for (uint32_t page = page_first; page < page_end; ++page) {
+    page_last_access_submission_[page] = submission;
+  }
+}
+
+void VulkanSharedMemory::OnRangesRequested(
+    const std::vector<std::pair<uint32_t, uint32_t>>& ranges) {
+  for (const auto& range : ranges) {
+    MarkPagesAccessed(range.first, range.second);
+  }
