+                             &type_index) &&
+      !rex::bit_scan_forward(host_types, &type_index)) {
+    REXGPU_WARN("Shared memory: no host-visible coherent memory type for zero-copy");
+    ui::vulkan::util::DestroyAndNullHandle(dfn.vkDestroyBuffer, device, buffer_);
+    return false;
