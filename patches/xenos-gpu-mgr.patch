+bool VulkanPipelineCache::CreateNativePipeline(
+    const PipelineCreationArguments& creation_arguments) {
+  VkSpecializationMapEntry spec_entry = {0, 0, sizeof(uint32_t)};
+  VkSpecializationInfo spec_info = {1, &spec_entry, sizeof(uint32_t),
+                                    &creation_arguments.native_spec_constants};
+  if (EnsurePipelineCreated(creation_arguments, creation_arguments.native_pixel_shader, &spec_info,
+                            true)) {
+    return true;
+  }
+  const auto* pixel_shader = creation_arguments.pixel_shader;
+  REXGPU_WARN("MGR native PS: pipeline creation failed for PS {:016X}",
+              pixel_shader ? pixel_shader->shader().ucode_data_hash() : 0);
+  return false;
+}
