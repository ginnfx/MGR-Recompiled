+  record.description = description;
+  record.pixel_ucode_hash = inputs.pixel_ucode_hash;
+  record.interpolator_mask = inputs.interpolator_mask;
+  record.spec_constants = spec_constants;
+  record.vertex_texture_count = inputs.vertex_texture_count;
+  record.vertex_sampler_count = inputs.vertex_sampler_count;
+  record.record_hash = record.ComputeHash();
+  // New native pipelines are rare after warm-up; flush so a crash keeps them.
+  if (fwrite(&record, sizeof(record), 1, native_storage_file_) == 1) {
+    fflush(native_storage_file_);
+  }
