+                   pixel_index.y)),
+      pixel_0, pixel_1);
+  // See resolve_full_128bpp.xesli: inside the filled columns, both pixels are
+  // the one to stretch.
+  dont_flatten_xe
+  if (pixel_index.x < resolve_info.half_pixel_offset_fill_source.x) {
+    pixel_1 = pixel_0;
+  }
+  // Only 32_32_32_32_FLOAT color format is 128bpp.
+  byte_buffer_align16_store16_xe(
+      xe_resolve_dest, XeResolveDestPixelAddress(resolve_info, pixel_index, 4u),
