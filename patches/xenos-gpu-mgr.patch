diff --git a/include/rex/graphics/vulkan/resolve_arena.h b/include/rex/graphics/vulkan/resolve_arena.h
new file mode 100644
index 0000000..b886816
--- /dev/null
+++ b/include/rex/graphics/vulkan/resolve_arena.h
@@ -0,0 +1,172 @@
+#pragma once
+
+#include <algorithm>
+#include <cassert>
+#include <cstdint>
+#include <vector>
+
+namespace rex::graphics::vulkan {
+
+// GPU-independent address planner. The caller records copies before using the
+// newly published mapping. Retired blocks remain unavailable until the
+// submission containing those copies ends. When space runs out, live blocks
+// that no in-flight submission uses and that were idle for at least
+// kEvictIdleSubmissions are evicted least-recently-used first. Their scaled
+// contents are lost: a later commit over that range reads zeros (see `fills`)
+// instead of failing the draw.
+class ResolveArena {
+ public:
+  struct Copy { uint64_t source, destination, length; };
+  struct Fill { uint64_t offset, length; };
+  struct Block {
+    uint64_t guest_begin, guest_end, offset, size;
+    uint64_t retire_after = 0;
+    bool retired = false;
+    mutable uint64_t last_use = 0;  // submission that last committed or bound it
+  };
+  static constexpr uint64_t kEvictIdleSubmissions = 64;
+
+  // `area_num / area_den` is the host bytes per guest byte (s*s, or 9/4 at
+  // 3/2). Guest offsets passed in are page-aligned or group-aligned, which
+  // keeps every scaled offset whole; ToHost asserts it.
+  void Reset(uint64_t capacity, uint32_t area_num, uint32_t area_den, uint64_t alignment) {
+    capacity_ = capacity;
+    area_ = area_num;
+    area_den_ = std::max<uint32_t>(area_den, 1);
+    alignment_ = std::max<uint64_t>(alignment, 1);
+    blocks_.clear();
+    evictions_ = 0;
+  }
+
+  // `use_submission` (if nonzero) marks the found block as used by it.
+  bool Lookup(uint64_t begin, uint64_t length, uint64_t& offset,
+              uint64_t use_submission = 0) const {
+    if (!length) { offset = 0; return true; }
+    if (begin > kGuestSize || length > kGuestSize - begin) return false;
+    for (const Block& block : blocks_) {
+      if (!block.retired && begin >= block.guest_begin &&
+          begin + length <= block.guest_end) {
+        offset = block.offset + ToHost(begin - block.guest_begin);
+        block.last_use = std::max(block.last_use, use_submission);
+        return true;
+      }
+    }
+    return false;
+  }
+
+  // Publishes a mapping for [begin, begin + length), page-aligned. `copies`
+  // move every overlapped live block into the new one (a resolve may write only
+  // a rectangle of its range, so no overlapped byte is assumed overwritten).
+  // `fills` are the new block's arena ranges that no previous mapping covered;
+  // the caller zeroes them, because the space may hold data of a retired or
+  // evicted block, and a range whose block was evicted is still flagged as
+  // scaled-resolved by the texture cache.
+  bool Commit(uint64_t begin, uint64_t length, uint64_t submission,
+              uint64_t completed, std::vector<Copy>& copies, std::vector<Fill>& fills) {
+    copies.clear();
+    fills.clear();
+    if (!length) return true;
+    if (!area_ || begin > kGuestSize || length > kGuestSize - begin) return false;
+    uint64_t existing;
+    if (Lookup(begin, length, existing, submission)) return true;
+    uint64_t end = (begin + length + 4095) & ~uint64_t(4095);
+    begin &= ~uint64_t(4095);
+    // Existing mappings are disjoint. Expand to preserve the full contents of
+    // every overlapped allocation, including bytes outside the new resolve.
+    bool expanded;
+    do {
+      expanded = false;
+      for (const Block& block : blocks_) {
+        if (block.retired || block.guest_end <= begin || block.guest_begin >= end) continue;
+        const uint64_t next_begin = std::min(begin, block.guest_begin);
+        const uint64_t next_end = std::max(end, block.guest_end);
+        expanded |= next_begin != begin || next_end != end;
+        begin = next_begin;
+        end = next_end;
+      }
+    } while (expanded);
+    const uint64_t size = ToHost(end - begin);
+    if (size > capacity_) return false;
+    blocks_.erase(std::remove_if(blocks_.begin(), blocks_.end(),
+        [completed](const Block& block) {
+          return block.retired && block.retire_after <= completed;
+        }), blocks_.end());
+    uint64_t offset;
+    while (!FindSpace(size, offset)) {
+      if (!EvictOne(begin, end, submission, completed)) return false;
+    }
+    // FindSpace sorted blocks_ by offset; the overlapped ones are collected in
+    // guest order to find the uncovered gaps.
+    std::vector<const Block*> overlapped;
+    for (Block& block : blocks_) {
+      if (block.retired || block.guest_end <= begin || block.guest_begin >= end) continue;
+      copies.push_back({block.offset, offset + ToHost(block.guest_begin - begin), block.size});
+      block.retired = true;
+      block.retire_after = submission;
+      overlapped.push_back(&block);
+    }
+    std::sort(overlapped.begin(), overlapped.end(), [](const Block* a, const Block* b) {
+      return a->guest_begin < b->guest_begin;
+    });
+    uint64_t covered = begin;
+    for (const Block* block : overlapped) {
+      if (block->guest_begin > covered)
+        fills.push_back({offset + ToHost(covered - begin), ToHost(block->guest_begin - covered)});
+      covered = block->guest_end;
+    }
+    if (covered < end) fills.push_back({offset + ToHost(covered - begin), ToHost(end - covered)});
+    Block& added = blocks_.emplace_back(Block{begin, end, offset, size});
+    added.last_use = submission;
+    return true;
+  }
+
+  uint64_t live_bytes() const {
+    uint64_t total = 0;
+    for (const Block& block : blocks_) if (!block.retired) total += block.size;
+    return total;
+  }
+  const std::vector<Block>& blocks() const { return blocks_; }
+  uint64_t evictions() const { return evictions_; }
+  static constexpr uint64_t kGuestSize = uint64_t(512) << 20;
+
+ private:
+  uint64_t capacity_ = 0, alignment_ = 1;
+  // First fit by offset; blocks_ is sorted by offset afterwards.
+  bool FindSpace(uint64_t size, uint64_t& offset_out) {
+    std::sort(blocks_.begin(), blocks_.end(), [](const Block& a, const Block& b) {
+      return a.offset < b.offset;
+    });
+    uint64_t offset = 0;
+    for (const Block& block : blocks_) {
+      if (offset <= block.offset && size <= block.offset - offset) break;
+      offset = ((block.offset + block.size + alignment_ - 1) / alignment_) * alignment_;
+    }
+    offset_out = offset;
+    return offset <= capacity_ && size <= capacity_ - offset;
+  }
+
+  // Drops the least recently used idle live block outside [begin, end).
+  bool EvictOne(uint64_t begin, uint64_t end, uint64_t submission, uint64_t completed) {
+    Block* victim = nullptr;
+    for (Block& block : blocks_) {
+      if (block.retired || (block.guest_end > begin && block.guest_begin < end)) continue;
+      if (block.last_use > completed || block.last_use + kEvictIdleSubmissions > submission)
+        continue;
+      if (!victim || block.last_use < victim->last_use) victim = &block;
+    }
+    if (!victim) return false;
+    *victim = blocks_.back();
+    blocks_.pop_back();
+    ++evictions_;
+    return true;
+  }
+
+  uint32_t area_ = 0, area_den_ = 1;
+  uint64_t ToHost(uint64_t guest_bytes) const {
+    assert(guest_bytes * area_ % area_den_ == 0);
+    return guest_bytes * area_ / area_den_;
+  }
+  uint64_t evictions_ = 0;
+  std::vector<Block> blocks_;
+};
+}  // namespace rex::graphics::vulkan
