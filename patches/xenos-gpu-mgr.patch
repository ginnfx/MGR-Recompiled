+  const ui::vulkan::VulkanDevice* const vulkan_device = GetVulkanDevice();
+  if (vulkan_device->functions().vkCreatePipelineLayout(vulkan_device->device(), &create_info,
+                                                        nullptr, &pipeline_layout) != VK_SUCCESS) {
+    REXGPU_ERROR("MGR native PS: pipeline layout creation failed");
+    return nullptr;
+  }
+  auto emplaced = native_pipeline_layouts_.emplace(
+      std::piecewise_construct, std::forward_as_tuple(key),
+      std::forward_as_tuple(pipeline_layout, descriptor_set_layout_textures_vertex,
+                            native_ps_.set_layout()));
+  return &emplaced.first->second;
+}
+
+const char* VulkanCommandProcessor::MgrSelectNativePixelShader(
+    const VulkanShader* pixel_shader, uint32_t interpolator_mask, bool memexport_used_pixel,
+    uint32_t normalized_color_mask, VkShaderModule& module_out, uint32_t& spec_constants_out,
+    float& alpha_threshold_out) {
+  module_out = VK_NULL_HANDLE;
+  spec_constants_out = 0;
+  alpha_threshold_out = 0.0f;
+  if (!pixel_shader || !native_ps_.enabled()) {
+    return "disabled";
+  }
+  if (memexport_used_pixel) {
+    return "memexport";
+  }
+  if (render_target_cache_->GetPath() != RenderTargetCache::Path::kHostRenderTargets) {
+    return "fsi";
+  }
+  const mgr_native::PixelShader* native = native_ps_.Find(pixel_shader->ucode_data_hash());
+  if (!native) {
+    return "no_shader";
+  }
+  const uint32_t flags = system_constants_.flags;
+  const uint32_t gamma_flags = SpirvShaderTranslator::kSysFlag_ConvertColor0ToGamma |
+                               SpirvShaderTranslator::kSysFlag_ConvertColor1ToGamma |
+                               SpirvShaderTranslator::kSysFlag_ConvertColor2ToGamma |
+                               SpirvShaderTranslator::kSysFlag_ConvertColor3ToGamma;
+  if (flags & gamma_flags) {
+    return "gamma";
+  }
+  // Xenia emulates alpha-to-coverage in its translated pixel shader; the
+  // native shaders have no equivalent.
+  if (system_constants_.alpha_to_mask) {
+    return "alpha_to_mask";
+  }
+  // Without view swizzles Xenia swizzles in the shader (texture_swizzles);
+  // native shaders rely on the view swizzle.
+  if (!GetVulkanDevice()->properties().imageViewFormatSwizzle) {
+    return "no_view_swizzle";
+  }
+  auto alpha_function = xenos::CompareFunction(
+      (flags >> SpirvShaderTranslator::kSysFlag_AlphaPassIfLess_Shift) & 0b111);
+  if (alpha_function != xenos::CompareFunction::kAlways) {
+    if (!(native->spec_constants_mask & mgr_native::kSpecConstantAlphaTest)) {
+      return "alpha_unsupported";
+    }
+    // XenosRecomp's alpha test is clip(alpha - threshold): pass if >= threshold.
+    if (alpha_function == xenos::CompareFunction::kGreaterEqual) {
+      alpha_threshold_out = system_constants_.alpha_test_reference;
+    } else if (alpha_function == xenos::CompareFunction::kGreater) {
+      alpha_threshold_out = std::nextafter(system_constants_.alpha_test_reference, INFINITY);
+    } else {
+      return "alpha_func";
+    }
+    spec_constants_out |= mgr_native::kSpecConstantAlphaTest;
+  }
+  for (uint32_t i = 0; i < xenos::kMaxColorRenderTargets; ++i) {
+    if (((normalized_color_mask >> (4 * i)) & 0b1111) &&
+        system_constants_.color_exp_bias[i] != 1.0f) {
+      return "exp_bias";
+    }
+  }
+  native_texture_views_.clear();
+  for (const auto& binding : pixel_shader->GetTextureBindingsAfterTranslation()) {
+    if (binding.fetch_constant >= mgr_native::kSlotCount) {
+      return "tex_slot";
+    }
+    uint8_t signs = texture_cache_->GetActiveTextureSwizzledSigns(binding.fetch_constant);
+    for (uint32_t component = 0; component < 4; ++component) {
+      auto sign = xenos::TextureSign((signs >> (2 * component)) & 0b11);
+      if (sign == xenos::TextureSign::kUnsignedBiased || sign == xenos::TextureSign::kGamma) {
+        return "tex_sign";
+      }
+    }
+    if (texture_util::IsAnySignSigned(signs) && texture_util::IsAnySignNotSigned(signs)) {
+      return "tex_sign_mixed";
+    }
+    VkImageView view = texture_cache_->MgrGetNativeView(binding.fetch_constant, binding.dimension,
+                                                         bool(binding.is_signed));
+    if (view == VK_NULL_HANDLE) {
+      return "tex_view";
+    }
+    uint32_t descriptor_binding;
+    switch (binding.dimension) {
+      case xenos::FetchOpDimension::k3DOrStacked:
+        descriptor_binding = mgr_native::kBindingTextures3D;
+        break;
+      case xenos::FetchOpDimension::kCube:
+        descriptor_binding = mgr_native::kBindingTexturesCube;
+        break;
+      default:
+        descriptor_binding = mgr_native::kBindingTextures2D;
+        break;
+    }
+    native_texture_views_.push_back({binding.fetch_constant, descriptor_binding, view});
+  }
+  // Native samplers are indexed by fetch constant, so two Xenia sampler
+  // bindings on one slot (different filter overrides) would collide.
+  uint32_t sampler_slots_used = 0;
+  for (const auto& binding : pixel_shader->GetSamplerBindingsAfterTranslation()) {
+    if (binding.fetch_constant >= mgr_native::kSlotCount) {
+      return "sampler_slot";
+    }
+    const uint32_t slot_bit = uint32_t(1) << binding.fetch_constant;
+    if (sampler_slots_used & slot_bit) {
+      return "sampler_shared_slot";
+    }
+    sampler_slots_used |= slot_bit;
+  }
+  module_out = native_ps_.GetModule(*native, interpolator_mask);
+  if (module_out == VK_NULL_HANDLE) {
+    return "interpolators";
+  }
+  return nullptr;
+}
+
+bool VulkanCommandProcessor::MgrBindNativePixelSet(const VulkanShader& pixel_shader,
+                                                   float alpha_threshold) {
+  static const bool cache_enabled = [] {
+    const char* value = std::getenv("MGR_NATIVE_BINDING_CACHE");
+    return !value || value[0] != '0';
+  }();
+  const RegisterFile& regs = *register_file_;
+  if (native_binding_cache_frame_ != frame_current_) {
+    native_binding_cache_frame_ = frame_current_;
+    native_constant_buffers_[0] = {};
+    native_constant_buffers_[1] = {};
+    native_constant_offsets_[0] = 0;
+    native_constant_offsets_[1] = 0;
+    native_cached_pixel_set_ = VK_NULL_HANDLE;
+  }
+  const void* pixel_values = &regs[XE_GPU_REG_SHADER_CONSTANT_256_X];
+  const void* bool_values = &regs[XE_GPU_REG_SHADER_CONSTANT_BOOL_000_031];
+  uint32_t alpha_bits;
+  std::memcpy(&alpha_bits, &alpha_threshold, sizeof(alpha_bits));
+  const bool pixel_upload = !cache_enabled || !native_constant_buffers_[0].buffer ||
+      native_pixel_constants_generation_used_ != native_pixel_constants_generation_;
+  const bool shared_upload = !cache_enabled || !native_constant_buffers_[1].buffer ||
+      native_shared_constants_generation_used_ != native_shared_constants_generation_ ||
+      native_alpha_snapshot_ != alpha_bits;
+  if (pixel_upload) {
+    VkDescriptorBufferInfo info{};
+    uint8_t* bytes = native_ps_.RequestUpload(frame_current_, mgr_native::kPixelConstantsBytes,
+                                              info.buffer, info.offset);
+    if (!bytes) return false;
+    native_constant_offsets_[0] = uint32_t(info.offset);
+    info.offset = 0;
+    info.range = mgr_native::kPixelConstantsBytes;
+    std::memcpy(bytes, pixel_values, mgr_native::kPixelConstantsBytes);
+    if (cache_enabled) {
+      native_pixel_constants_generation_used_ = native_pixel_constants_generation_;
+    }
+    native_constant_buffers_[0] = info;
+  }
+  if (shared_upload) {
+    VkDescriptorBufferInfo info{};
+    uint8_t* bytes = native_ps_.RequestUpload(frame_current_, mgr_native::kSharedConstantsBytes,
+                                              info.buffer, info.offset);
+    if (!bytes) return false;
+    native_constant_offsets_[1] = uint32_t(info.offset);
+    info.offset = 0;
+    info.range = mgr_native::kSharedConstantsBytes;
+    std::memset(bytes, 0, mgr_native::kSharedConstantsBytes);
+    std::memcpy(bytes + mgr_native::kSharedBooleansOffset, bool_values,
+                sizeof(native_bool_constants_snapshot_));
+    std::memcpy(bytes + mgr_native::kSharedAlphaThresholdOffset, &alpha_threshold, sizeof(float));
+    if (cache_enabled) {
+      native_shared_constants_generation_used_ = native_shared_constants_generation_;
+      native_alpha_snapshot_ = alpha_bits;
+    }
+    native_constant_buffers_[1] = info;
+  }
+
+  const auto& samplers = pixel_shader.GetSamplerBindingsAfterTranslation();
+  native_image_infos_.clear();
+  native_image_infos_.reserve(native_texture_views_.size() + samplers.size());
+  for (const NativeTextureView& texture : native_texture_views_) {
+    native_image_infos_.push_back(
+        {VK_NULL_HANDLE, texture.view, VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL});
+  }
+  for (size_t i = 0; i < samplers.size() && i < current_samplers_pixel_.size(); ++i) {
+    native_image_infos_.push_back(
+        {current_samplers_pixel_[i].second, VK_NULL_HANDLE, VK_IMAGE_LAYOUT_UNDEFINED});
+  }
+  const bool set_reused = cache_enabled && native_cached_pixel_set_ != VK_NULL_HANDLE &&
+      native_cached_pixel_shader_ == &pixel_shader &&
+      native_cached_constant_buffers_[0] == native_constant_buffers_[0].buffer &&
+      native_cached_constant_buffers_[1] == native_constant_buffers_[1].buffer &&
+      native_image_infos_.size() == native_cached_image_infos_.size() &&
+      std::equal(native_image_infos_.begin(), native_image_infos_.end(),
+                 native_cached_image_infos_.begin(),
+                 [](const VkDescriptorImageInfo& a, const VkDescriptorImageInfo& b) {
+                   return a.sampler == b.sampler && a.imageView == b.imageView &&
+                          a.imageLayout == b.imageLayout;
+                 });
+  auto bind_native_set = [&](VkDescriptorSet set) {
+    if (native_bound_pixel_set_ == set &&
+        native_bound_pixel_layout_ == current_guest_graphics_pipeline_layout_ &&
+        native_bound_constant_offsets_[0] == native_constant_offsets_[0] &&
+        native_bound_constant_offsets_[1] == native_constant_offsets_[1]) {
+      return;
+    }
+    const uint32_t dynamic_offsets[2] = {native_constant_offsets_[0],
+                                        native_constant_offsets_[1]};
+    deferred_command_buffer_.CmdVkBindDescriptorSets(
+        VK_PIPELINE_BIND_POINT_GRAPHICS,
+        current_guest_graphics_pipeline_layout_->GetPipelineLayout(),
+        SpirvShaderTranslator::kDescriptorSetTexturesPixel, 1, &set, 2, dynamic_offsets);
+    native_bound_pixel_set_ = set;
+    native_bound_pixel_layout_ = current_guest_graphics_pipeline_layout_;
+    native_bound_constant_offsets_[0] = native_constant_offsets_[0];
+    native_bound_constant_offsets_[1] = native_constant_offsets_[1];
+  };
+  if (set_reused) {
+    bind_native_set(native_cached_pixel_set_);
+    current_graphics_descriptor_sets_bound_up_to_date_ &=
+        ~(UINT32_C(1) << SpirvShaderTranslator::kDescriptorSetTexturesPixel);
+    native_ps_.CountBindings(pixel_upload, shared_upload, true);
+    return true;
+  }
+  VkDescriptorSet set = native_ps_.AllocateSet(frame_current_);
+  if (set == VK_NULL_HANDLE) return false;
+  native_writes_.clear();
+  for (uint32_t i = 0; i < 2; ++i) {
+    VkWriteDescriptorSet& write = native_writes_.emplace_back();
+    write = {VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET};
+    write.dstSet = set;
+    write.dstBinding = i;
+    write.descriptorCount = 1;
+    write.descriptorType = VK_DESCRIPTOR_TYPE_STORAGE_BUFFER_DYNAMIC;
+    write.pBufferInfo = &native_constant_buffers_[i];
+  }
+  size_t image_index = 0;
+  for (const NativeTextureView& texture : native_texture_views_) {
+    VkWriteDescriptorSet& write = native_writes_.emplace_back();
+    write = {VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET};
+    write.dstSet = set;
+    write.dstBinding = texture.binding;
+    write.dstArrayElement = texture.fetch_constant;
+    write.descriptorCount = 1;
+    write.descriptorType = VK_DESCRIPTOR_TYPE_SAMPLED_IMAGE;
+    write.pImageInfo = &native_image_infos_[image_index++];
+  }
+  for (size_t i = 0; i < samplers.size() && i < current_samplers_pixel_.size(); ++i) {
+    VkWriteDescriptorSet& write = native_writes_.emplace_back();
+    write = {VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET};
+    write.dstSet = set;
+    write.dstBinding = mgr_native::kBindingSamplers;
+    write.dstArrayElement = samplers[i].fetch_constant;
+    write.descriptorCount = 1;
+    write.descriptorType = VK_DESCRIPTOR_TYPE_SAMPLER;
+    write.pImageInfo = &native_image_infos_[image_index++];
+  }
+  const ui::vulkan::VulkanDevice* const vulkan_device = GetVulkanDevice();
+  vulkan_device->functions().vkUpdateDescriptorSets(vulkan_device->device(),
+                                                    uint32_t(native_writes_.size()),
+                                                    native_writes_.data(), 0, nullptr);
+  bind_native_set(set);
+  // Xenia's tracker describes its own pixel set, which this binding replaced.
+  current_graphics_descriptor_sets_bound_up_to_date_ &=
+      ~(UINT32_C(1) << SpirvShaderTranslator::kDescriptorSetTexturesPixel);
+  if (cache_enabled) {
+    native_cached_pixel_set_ = set;
+    native_cached_pixel_shader_ = &pixel_shader;
+    native_cached_constant_buffers_[0] = native_constant_buffers_[0].buffer;
+    native_cached_constant_buffers_[1] = native_constant_buffers_[1].buffer;
+    native_cached_image_infos_ = native_image_infos_;
+  }
+  native_ps_.CountBindings(pixel_upload, shared_upload, false);
+  return true;
+}
