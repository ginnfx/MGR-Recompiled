+
+void VulkanCommandProcessor::SetDrawResolutionScaleLive(
+    ScaleRatio scale_x, ScaleRatio scale_y, std::function<void(bool)> completion) {
+  if (!ScaleRatio::IsSupported(scale_x) || !ScaleRatio::IsSupported(scale_y)) {
+    scale_x = scale_y = ScaleRatio::Integer(1);
+  }
+  CallInThread([this, scale_x, scale_y, completion = std::move(completion)]() mutable {
+    const ScaleRatio old_x =
+        texture_cache_ ? texture_cache_->draw_resolution_ratio_x() : ScaleRatio::Integer(1);
+    const ScaleRatio old_y =
+        texture_cache_ ? texture_cache_->draw_resolution_ratio_y() : ScaleRatio::Integer(1);
+    const ScaleRatio old_active =
+        resolution_context_ready_ && texture_cache_ ? old_x : kNoActiveScale;
+    if (resolution_context_ready_ && texture_cache_ && scale_x == old_x && scale_y == old_y) {
+      PublishMgrResolutionStatus(scale_x, "active", old_x);
+      if (completion) completion(true);
+      return;
+    }
+
+    PublishMgrResolutionStatus(scale_x, "applying", old_active);
+
+    const bool had_vertex_shader = active_vertex_shader_ != nullptr;
+    const bool had_pixel_shader = active_pixel_shader_ != nullptr;
+    std::vector<uint32_t> vertex_ucode = had_vertex_shader
+        ? active_vertex_shader_->ucode_data() : std::vector<uint32_t>{};
+    std::vector<uint32_t> pixel_ucode = had_pixel_shader
+        ? active_pixel_shader_->ucode_data() : std::vector<uint32_t>{};
+
+    // Finish the current command list before destroying resources it references.
+    // ShutdownContext waits for submitted work and tears down all scale-specific
+    // caches, pipelines, EDRAM and descriptor layouts on this same worker thread.
+    if (submission_open_ && !EndSubmission(false)) {
+      PublishMgrResolutionStatus(scale_x, "failed", old_active,
+                                 "Could not finish the current GPU submission; rebuild not started");
+      if (completion) completion(false);
+      return;
+    }
+    // Shader objects belong to the pipeline cache, which ShutdownContext
+    // destroys. Preserve their guest microcode and re-intern them afterward.
+    resolution_change_in_progress_ = true;
+    PublishMgrResolutionStatus(scale_x, "applying", kNoActiveScale, "Rebuilding Vulkan resources");
+    active_vertex_shader_ = nullptr;
+    active_pixel_shader_ = nullptr;
+    SetDrawResolutionScaleCvars(scale_x, scale_y);
+    ShutdownContext();
+    auto initialize_context = [&]() {
+      if (!SetupContext()) return false;
+      if (!shader_cache_root_.empty()) {
+        InitializeShaderStorage(shader_cache_root_, shader_cache_title_id_,
+                                shader_cache_blocking_);
+      }
+      auto restore_shader = [this](xenos::ShaderType type,
+                                   const std::vector<uint32_t>& ucode) -> Shader* {
+        if (ucode.empty()) return nullptr;
+        std::vector<uint32_t> guest_ucode = ucode;
+        for (uint32_t& dword : guest_ucode) dword = rex::byte_swap(dword);
+        return LoadShader(type, 0, guest_ucode.data(), uint32_t(guest_ucode.size()));
+      };
+      if (had_vertex_shader) {
+        active_vertex_shader_ = restore_shader(xenos::ShaderType::kVertex, vertex_ucode);
+      }
+      if (had_pixel_shader) {
+        active_pixel_shader_ = restore_shader(xenos::ShaderType::kPixel, pixel_ucode);
+      }
+      return (!had_vertex_shader || active_vertex_shader_) &&
+             (!had_pixel_shader || active_pixel_shader_);
+    };
+    bool initialized = initialize_context();
+    const bool request_initialized = initialized;
+    const std::string request_error = resolution_initialization_error_;
+    if (!initialized) {
+      // Higher scales can fail allocation on constrained devices. Restore the
+      // previous scale and renderer before reporting failure to the UI.
+      active_vertex_shader_ = nullptr;
+      active_pixel_shader_ = nullptr;
+      ShutdownContext();
+      SetDrawResolutionScaleCvars(old_x, old_y);
+      initialized = initialize_context();
+    }
+    resolution_context_ready_ = initialized;
+    resolution_change_in_progress_ = false;
+    const bool requested_scale_active = request_initialized && initialized && texture_cache_ &&
+        texture_cache_->draw_resolution_ratio_x() == scale_x &&
+        texture_cache_->draw_resolution_ratio_y() == scale_y;
+    std::string failure_reason;
+    if (!requested_scale_active) {
+      failure_reason = request_error.empty() ? "Vulkan shader restoration failed" : request_error;
+      failure_reason += initialized
+          ? "; previous scale recreated, render-target contents not restored. See GPU log."
+          : "; recovery also failed, no active renderer. Restart required. See GPU log.";
+    }
+    PublishMgrResolutionStatus(scale_x, requested_scale_active ? "active" : "failed",
+        initialized && texture_cache_ ? texture_cache_->draw_resolution_ratio_x() : kNoActiveScale,
+        failure_reason);
+    if (completion) completion(requested_scale_active);
+  });
+}
