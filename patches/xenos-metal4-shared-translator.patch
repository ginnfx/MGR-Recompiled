+
+// Vulkan device queries belong to the backend, not the shared Xenos translator.
+#include <rex/graphics/vulkan/shader_features.h>
+#include <rex/ui/vulkan/device.h>
+
+namespace rex::graphics::vulkan {
+SpirvShaderTranslator::Features GetVulkanShaderFeatures(const ui::vulkan::VulkanDevice* vulkan_device) {
+  SpirvShaderTranslator::Features features(false);
+  features.max_storage_buffer_range = vulkan_device->properties().maxStorageBufferRange;
+  features.full_draw_index_uint32 = vulkan_device->properties().fullDrawIndexUint32;
+  features.vertex_pipeline_stores_and_atomics = vulkan_device->properties().vertexPipelineStoresAndAtomics;
+  features.fragment_stores_and_atomics = vulkan_device->properties().fragmentStoresAndAtomics;
+  features.clip_distance = vulkan_device->properties().shaderClipDistance;
+  features.cull_distance = vulkan_device->properties().shaderCullDistance;
+  features.image_view_format_swizzle = vulkan_device->properties().imageViewFormatSwizzle;
+  features.signed_zero_inf_nan_preserve_float32 = vulkan_device->properties().shaderSignedZeroInfNanPreserveFloat32;
+  features.denorm_flush_to_zero_float32 = vulkan_device->properties().shaderDenormFlushToZeroFloat32;
+  features.rounding_mode_rte_float32 = vulkan_device->properties().shaderRoundingModeRTEFloat32;
+  features.fragment_shader_sample_interlock = vulkan_device->properties().fragmentShaderSampleInterlock;
+  features.demote_to_helper_invocation = vulkan_device->properties().shaderDemoteToHelperInvocation;
+  features.sample_rate_shading = vulkan_device->properties().sampleRateShading;
+  const uint32_t vulkan_api_version = vulkan_device->properties().apiVersion;
+  if (vulkan_api_version >= VK_MAKE_API_VERSION(0, 1, 2, 0)) {
+    features.spirv_version = spv::Spv_1_5;
+  } else if (vulkan_device->extensions().ext_1_2_KHR_spirv_1_4) {
+    features.spirv_version = spv::Spv_1_4;
+  } else if (vulkan_api_version >= VK_MAKE_API_VERSION(0, 1, 1, 0)) {
+    features.spirv_version = spv::Spv_1_3;
+  } else {
+    features.spirv_version = spv::Spv_1_0;
+  }
+  return features;
+}
+}  // namespace rex::graphics::vulkan
