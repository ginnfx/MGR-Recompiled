+// DXC lowers `precise` to NoContraction but never decorates the position
+// builtin Invariant. MoltenVK only compiles with preserveInvariance (MSL
+// [[invariant]]) when it is, and MGR's equal-depth colour passes need the
+// pre-pass and colour vertex shaders to produce identical depth.
+static std::vector<uint32_t> MarkPositionInvariant(const std::vector<uint32_t>& words)
+{
+    constexpr uint32_t OP_DECORATE = 71;
+    constexpr uint32_t DECORATION_INVARIANT = 0;
+    constexpr uint32_t DECORATION_BUILTIN = 11;
+    constexpr uint32_t BUILTIN_POSITION = 0;
+    constexpr size_t HEADER_WORDS = 5;
+
+    std::vector<uint32_t> out(words.begin(), words.begin() + std::min(words.size(), HEADER_WORDS));
+    for (size_t i = HEADER_WORDS; i < words.size();)
+    {
+        const uint32_t wordCount = words[i] >> 16;
+        if (wordCount == 0 || i + wordCount > words.size())
+            return words;
+
+        out.insert(out.end(), words.begin() + i, words.begin() + i + wordCount);
+        if ((words[i] & 0xFFFF) == OP_DECORATE && wordCount == 4 &&
+            words[i + 2] == DECORATION_BUILTIN && words[i + 3] == BUILTIN_POSITION)
+        {
+            out.insert(out.end(), { (3u << 16) | OP_DECORATE, words[i + 1], DECORATION_INVARIANT });
+        }
+        i += wordCount;
+    }
+    return out;
+}
