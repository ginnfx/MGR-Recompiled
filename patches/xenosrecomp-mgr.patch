+        // MGR native bundle (XENOS_RECOMP_NATIVE_BUNDLE=<file>): little-endian
+        // header "XRNB" u32 version, u32 count; per entry: u64 ucode hash (XXH3_64 of
+        // the container's microcode == Xenia's ucode_data_hash), u64 container
+        // hash, u32 stage (1 = pixel), u32 spec constants mask, u32 spirv bytes, spirv.
+        if (const char* bundlePath = std::getenv("XENOS_RECOMP_NATIVE_BUNDLE"))
+        {
+            std::vector<uint8_t> bundle;
+            auto put = [&bundle](const void* p, size_t n) {
+                bundle.insert(bundle.end(), static_cast<const uint8_t*>(p), static_cast<const uint8_t*>(p) + n);
+            };
+            const uint32_t magic = 0x424E5258, version = 1, count = uint32_t(shaders.size());
+            put(&magic, 4); put(&version, 4); put(&count, 4);
+            for (auto& [hash, shader] : shaders)
+            {
+                auto container = reinterpret_cast<const ShaderContainer*>(shader.data);
+                auto guest = reinterpret_cast<const Shader*>(shader.data + container->shaderOffset);
+                const uint8_t* ucode = shader.data + container->virtualSize + guest->physicalOffset;
+                const uint64_t ucodeHash = XXH3_64bits(ucode, guest->size);
+                const uint64_t containerHash = hash;
+                const uint32_t stage = shader.isPixelShader ? 1 : 0;
+                const uint32_t size = uint32_t(shader.rawSpirv.size());
+                put(&ucodeHash, 8); put(&containerHash, 8); put(&stage, 4);
+                put(&shader.specConstantsMask, 4); put(&size, 4);
+                put(shader.rawSpirv.data(), size);
+            }
+            writeAllBytes(bundlePath, bundle.data(), bundle.size());
+            fmt::println("Wrote native bundle {} ({} shaders, {} bytes)", bundlePath, count, bundle.size());
+        }
+
         fmt::println("Creating shader cache...");
 
         StringBuffer f;
